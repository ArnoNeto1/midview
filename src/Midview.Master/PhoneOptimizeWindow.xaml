<local:MidviewWindow x:Class="Midview.Master.PhoneOptimizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Midview.Master"
        Title="Otimizar os celulares" Height="600" Width="640" MinHeight="420" MinWidth="520"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="24,22,24,20">
        <StackPanel DockPanel.Dock="Top">
            <local:DialogHeader x:Name="DialogHeading" Icon="&#xE8EA;" Heading="Otimizar os celulares" Accent="{StaticResource CelularesBrush}">
                <TextBlock x:Name="TargetsTextBlock" Style="{StaticResource Hint}" />
            </local:DialogHeader>
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                           Text="Esconde os apps de propaganda que vêm de fábrica no celular (eles não são apagados) e liga o DNS sem anúncios, que tira a maior parte dos anúncios dos sites e dos apps. Se a rede não deixar o DNS sem anúncios funcionar, o celular continua com a internet de sempre. Cada celular leva de alguns segundos a um minuto." />
            </Border>
            <DockPanel Margin="0,14,0,10">
                <Button x:Name="RunButton" DockPanel.Dock="Left" Content="Otimizar de novo" Click="OnRunClicked" Padding="14,6" Margin="0,0,12,0" IsEnabled="False" />
                <TextBlock x:Name="ProgressTextBlock" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="PhonesList" ItemTemplate="{StaticResource PhoneRowTemplate}" />
        </ScrollViewer>
    </DockPanel>
</local:MidviewWindow>
