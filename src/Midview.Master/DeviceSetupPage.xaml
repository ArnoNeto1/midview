<UserControl x:Class="Midview.Master.DeviceSetupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Midview.Master"
             SizeChanged="OnSizeChanged" IsVisibleChanged="OnIsVisibleChanged">
    <!-- "Configurar celular" and "Configurar tablet" of "Máquinas da sala": one page, the kind given by Show. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel>
            <local:DialogHeader x:Name="Header" Accent="{StaticResource ConfigurarBrush}" />

            <!-- A new device, by the cable (the "Preparar celulares" assistant). -->
            <TextBlock x:Name="NewSectionHeading" FontSize="11.5" FontWeight="Bold" TextWrapping="Wrap"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,18,0,4" />
            <TextBlock x:Name="IntroLine" Style="{StaticResource Hint}" FontSize="13" />

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Antes de começar" Style="{StaticResource CardTitle}" />
                    <TextBlock x:Name="ResetLine" Style="{StaticResource Hint}" FontSize="13" Margin="0,8,0,0" />
                    <TextBlock x:Name="SwitchesLine" Style="{StaticResource Hint}" FontSize="13" Margin="0,4,0,0" />
                    <TextBlock x:Name="CableLine" Style="{StaticResource Hint}" FontSize="13" Margin="0,4,0,0" />
                    <!-- The school's Mi account (MiAccountFile): saved or changed in the assistant, taken off here too. -->
                    <TextBlock x:Name="MiAccountLine" Style="{StaticResource Hint}" FontSize="13" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <!-- The two ways, side by side (one under the other when the window is narrow: OnSizeChanged). -->
            <Grid x:Name="ChoicesGrid" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="ChoicesGap" Width="12" />
                    <ColumnDefinition x:Name="SecondColumn" Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="OptimizedCard" Style="{StaticResource Card}" Padding="14">
                    <DockPanel>
                        <Button x:Name="OptimizedButton" DockPanel.Dock="Bottom" Content="Preparar otimizado..." Click="OnOptimizedClicked"
                                Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Padding="14,6" Margin="0,12,0,0" />
                        <StackPanel>
                            <Border HorizontalAlignment="Left" CornerRadius="999" Background="{StaticResource AccentSoftBrush}"
                                    Padding="9,2" Margin="0,0,0,8">
                                <TextBlock Text="Recomendado" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentTextBrush}" />
                            </Border>
                            <TextBlock Text="Midview otimizado" Style="{StaticResource CardTitle}" />
                            <TextBlock x:Name="OptimizedText" Style="{StaticResource Hint}" FontSize="13" Margin="0,6,0,0" />
                            <TextBlock x:Name="GainText" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource OnlineBrush}" Margin="0,8,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border x:Name="OnlyMidviewCard" Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                    <DockPanel>
                        <Button x:Name="OnlyMidviewButton" DockPanel.Dock="Bottom" Content="Preparar só o Midview..." Click="OnOnlyMidviewClicked"
                                HorizontalAlignment="Left" Padding="14,6" Margin="0,12,0,0" />
                        <StackPanel>
                            <TextBlock Text="Só o Midview" Style="{StaticResource CardTitle}" />
                            <TextBlock x:Name="OnlyMidviewText" Style="{StaticResource Hint}" FontSize="13" Margin="0,6,0,0" />
                            <TextBlock Text="Sem ganho de memória." Style="{StaticResource Hint}" Margin="0,8,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Why the buttons are off (PhoneSetupOffer other than Wizard); hidden when they work. -->
            <TextBlock x:Name="GateText" Style="{StaticResource WarningText}" FontSize="12" Margin="0,10,0,0" />

            <TextBlock x:Name="KeptText" Style="{StaticResource Hint}" Margin="0,12,0,0" />

            <!-- The room's devices of that kind: what was in the "Telas" menu. -->
            <local:DeviceRoomSection x:Name="RoomSection" Margin="0,0,0,8" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
