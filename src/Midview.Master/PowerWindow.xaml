<local:MidviewWindow x:Class="Midview.Master.PowerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Midview.Master"
        Title="Desligar" Height="720" Width="520" MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="24,22,24,20">
        <StackPanel DockPanel.Dock="Top">
            <local:DialogHeader x:Name="Header" Icon="&#xE7E8;" Heading="Desligar" Accent="{StaticResource EnergiaBrush}">
                <TextBlock x:Name="TargetsTextBlock" Style="{StaticResource Hint}" />
            </local:DialogHeader>
            <Border Style="{StaticResource Card}" Margin="0,16,0,10">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ShutdownRadioButton" GroupName="Action" IsChecked="True" Content="Desligar" Margin="0,0,16,0" Checked="OnActionChanged" />
                    <RadioButton x:Name="RestartRadioButton" GroupName="Action" Content="Reiniciar" Checked="OnActionChanged" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <RadioButton x:Name="OneMinuteRadioButton" GroupName="Delay" IsChecked="True" Content="Avisar o aluno e esperar 1 minuto" Margin="0,0,0,4" />
                    <RadioButton x:Name="FiveMinutesRadioButton" GroupName="Delay" Content="Avisar o aluno e esperar 5 minutos" Margin="0,0,0,4" />
                    <RadioButton x:Name="NowRadioButton" GroupName="Delay" Content="Agora, sem esperar" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="O Windows mostra ao aluno um aviso com a contagem. Quando o tempo acaba, os programas abertos são fechados sem salvar. Vale também para máquinas sem ninguém logado." />
                </StackPanel>
            </Border>
            <!-- Off each time the window opens: installing can keep a machine busy for minutes. -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <CheckBox x:Name="InstallUpdatesCheckBox" FontWeight="SemiBold" Checked="OnActionChanged" Unchecked="OnActionChanged"
                              Content="Instalar as atualizações do Windows que estiverem esperando" />
                    <TextBlock x:Name="UpdatesHintTextBlock" Style="{StaticResource Hint}" Margin="20,4,0,0" />
                </StackPanel>
            </Border>
            <DockPanel Margin="0,0,0,10">
                <Button x:Name="CancelShutdownButton" DockPanel.Dock="Right" Content="Cancelar desligamento" Click="OnCancelShutdownClicked"
                        Padding="14,6" Margin="8,0,0,0"
                        ToolTip="Cancela, nas mesmas máquinas, um desligamento ou reinício que ainda está na contagem." />
                <Button x:Name="RunButton" Content="Desligar" Click="OnRunClicked" Style="{StaticResource DangerButton}" Padding="14,6" />
            </DockPanel>
        </StackPanel>
        <Border Style="{StaticResource ResultCard}">
            <DockPanel>
                <TextBlock x:Name="ProgressTextBlock" DockPanel.Dock="Top" TextWrapping="Wrap" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ResultTextBlock" TextWrapping="Wrap" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</local:MidviewWindow>
