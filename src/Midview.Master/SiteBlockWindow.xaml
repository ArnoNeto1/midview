<local:MidviewWindow x:Class="Midview.Master.SiteBlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Midview.Master"
        Title="Bloquear sites" Height="680" Width="540" MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="24,22,24,20">
        <StackPanel DockPanel.Dock="Top">
            <local:DialogHeader Icon="&#xE774;" Heading="Bloquear sites" Accent="{StaticResource ProgramasBrush}">
                <TextBlock x:Name="TargetsTextBlock" Style="{StaticResource Hint}" />
            </local:DialogHeader>
            <TextBlock x:Name="PersistenceTextBlock" Style="{StaticResource Hint}" Margin="0,12,0,0" />

            <Border Style="{StaticResource Card}" Margin="0,12,0,10">
                <StackPanel>
                    <TextBlock Text="Internet inteira" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                    <WrapPanel>
                        <Button Content="Bloquear a internet" Click="OnBlockInternetClicked" Style="{StaticResource DangerButton}" Padding="12,5" Margin="0,0,8,0" />
                        <Button Content="Liberar a internet" Click="OnUnblockInternetClicked" Padding="12,5" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Um site (por exemplo youtube.com)" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                    <TextBox x:Name="SiteTextBox" Margin="0,0,0,8" />
                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="Bloquear o site" Click="OnBlockSiteClicked" Style="{StaticResource DangerButton}" Padding="12,5" Margin="0,0,8,0" />
                        <Button Content="Liberar o site" Click="OnUnblockSiteClicked" Padding="12,5" />
                    </WrapPanel>
                    <TextBlock x:Name="SiteHintTextBlock" Style="{StaticResource Hint}" />
                    <TextBlock x:Name="PhoneNoteTextBlock" Style="{StaticResource Hint}" Margin="0,6,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </StackPanel>
        <Border Style="{StaticResource ResultCard}">
            <DockPanel>
                <TextBlock x:Name="ProgressTextBlock" DockPanel.Dock="Top" TextWrapping="Wrap" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ResultTextBlock" TextWrapping="Wrap" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</local:MidviewWindow>
