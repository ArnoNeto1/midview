<local:MidviewWindow x:Class="Midview.Master.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Midview.Master"
        Title="Midview - Sala de aula" Height="760" Width="1340"
        Background="{StaticResource BackgroundBrush}"
        Closing="OnWindowClosing" Closed="OnWindowClosed" KeyDown="OnWindowKeyDown" PreviewMouseWheel="OnWindowPreviewMouseWheel">
    <!-- The window draws its own title bar (MainWindow.TitleBar.cs); Windows still
         drags it by the 32 px bar, maximizes it on a double click there and snaps it
         to the screen's edges, and resizes it from its edges. The caption starts below
         the 6 px top resize band, so 26 of it reach the bar's bottom and not the
         toolbar (ShowWindowState adds the maximized margin). -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="26" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <DockPanel x:Name="WindowRoot">
        <!-- The title bar: the Midview mark, the lesson on and how many machines answer
             (UpdateTitleChips), and the window's buttons. -->
        <Grid DockPanel.Dock="Top" Height="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <!-- The Midview logo, from the program's icon at the size this screen needs (ShowTitleLogo). -->
                <Image x:Name="TitleLogo" Width="20" Height="20" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <!-- One line of text, so "Sala de aula" sits on the same baseline as "Midview". -->
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center">
                    <Run Text="Midview" FontSize="15" FontWeight="SemiBold" />
                    <Run Text=" Sala de aula" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="18,0,0,0">
                    <Border x:Name="LessonChip" Style="{StaticResource TitleChip}" Visibility="Collapsed">
                        <Border.BorderBrush>
                            <SolidColorBrush Color="#2DD4BF" Opacity="0.5" />
                        </Border.BorderBrush>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8F7;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,0,5,0"
                                       Foreground="{StaticResource AccentTextBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="LessonChipText" Foreground="{StaticResource AccentTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="MachineCountChip" Style="{StaticResource TitleChip}" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Margin="0,0,5,0" Fill="{StaticResource OnlineBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="MachineCountChipText" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButton}" Content="&#xE921;" Click="OnMinimizeClicked"
                        AutomationProperties.Name="Minimizar" />
                <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}" Content="&#xE922;" Click="OnMaximizeClicked"
                        AutomationProperties.Name="Maximizar" />
                <Button x:Name="CloseButton" Style="{StaticResource TitleBarCloseButton}" Content="&#xE8BB;" Click="OnCloseClicked"
                        AutomationProperties.Name="Fechar" />
            </StackPanel>
        </Grid>

        <!-- Grouped like the actions they hold, each group a panel in its color; one row
             from about 1312 px wide (so on a 1366px screen, and the window opens 1340 wide
             to fit one), and whole groups move to a second row on a narrower window. -->
        <Border DockPanel.Dock="Top" Padding="2,0,2,6">
            <WrapPanel x:Name="ToolbarPanel">
                <!-- Energia first, as the owner asked. -->
                <Border Style="{StaticResource ToolbarGroupPanel}" local:ToolbarButton.IconBrush="{StaticResource EnergiaBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <local:ToolbarButton Content="Desligar" Icon="&#xE7E8;" local:DeviceActions.Action="Power" Click="OnPowerClassClicked" OpensOptions="True"
                                                 ToolTip="Desliga a turma, com aviso aos alunos." />
                            <local:ToolbarButton Content="Reiniciar" Icon="&#xE72C;" local:DeviceActions.Action="Power" Click="OnRestartClassClicked" OpensOptions="True"
                                                 ToolTip="Reinicia a turma, com aviso aos alunos." />
                            <local:ToolbarButton Content="Ligar" Icon="&#xE945;" local:DeviceActions.Action="Wake" Click="OnWakeClassClicked"
                                                 ToolTip="Liga na hora, pela rede, as máquinas desligadas da sala. Elas precisam estar na tomada, no cabo de rede e com o Wake-on-LAN ativado na BIOS." />
                            <local:ToolbarButton Content="Agendar" Icon="&#xE787;" local:DeviceActions.Action="Schedule" Click="OnScheduleClicked" OpensOptions="True"
                                                 ToolTip="Escolhe dias e horários para ligar e desligar o laboratório." />
                        </StackPanel>
                        <ContentControl Content="Energia" Style="{StaticResource ToolbarGroupCaption}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ToolbarGroupPanel}" local:ToolbarButton.IconBrush="{StaticResource TelaBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <local:ToolbarButton x:Name="ViewButton" Content="Ver a tela" Icon="&#xE890;" Click="OnViewSelectedClicked"
                                                 IsEnabled="False" ToolTip="Abre a tela da máquina selecionada, só para ver." />
                            <local:ToolbarButton x:Name="ControlButton" Content="Controlar" Icon="&#xE7C9;" Click="OnControlSelectedClicked"
                                                 IsEnabled="False" ToolTip="Controla a máquina selecionada e trava o teclado e o mouse do aluno." />
                            <!-- Becomes "Desbloquear telas" while any screen is locked, with the padlock in
                                 its screen closed instead of open (UpdateScreenLockButton, ScreenLockText).
                                 One word per line in both. Width overridden from the shared 58: "Desbloquear"
                                 alone measures 65px at this font, wider than the 58px the default width
                                 leaves, so it would break mid-word. 72 leaves 66px. -->
                            <local:ToolbarButton x:Name="ScreenLockButton" Content="Bloquear&#10;telas" Icon="&#xE7F4;" Badge="&#xE785;"
                                                 BadgeInScreen="True" Width="72" local:DeviceActions.Action="ScreenLock" Click="OnScreenLockClassClicked"
                                                 ToolTip="Cobre a tela de todos os alunos com um cadeado e trava o teclado e o mouse." />
                        </StackPanel>
                        <ContentControl Content="Tela" Style="{StaticResource ToolbarGroupCaption}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ToolbarGroupPanel}" local:ToolbarButton.IconBrush="{StaticResource TurmaBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <local:ToolbarButton Content="Mensagem" Icon="&#xE8BD;" local:DeviceActions.Action="Message" Click="OnMessageClassClicked" OpensOptions="True"
                                                 ToolTip="Envia uma mensagem para a turma toda." />
                            <!-- No options arrow: like "Ligar", it acts right away, opening the chat on every student's screen. -->
                            <local:ToolbarButton Content="Bate-papo" Icon="&#xE8F2;" local:DeviceActions.Action="Chat" Click="OnChatClassClicked"
                                                 ToolTip="Abre uma conversa com a turma toda: o que você escreve aparece para todos os alunos, e as respostas deles só para você." />
                            <local:ToolbarButton Content="Enviar arquivo" Icon="&#xE898;" local:DeviceActions.Action="SendFile" Click="OnFileClassClicked" OpensOptions="True"
                                                 ToolTip="Envia um arquivo para a turma toda." />
                            <local:ToolbarButton Content="Recolher arquivos" Icon="&#xE896;" local:DeviceActions.Action="CollectFiles" Click="OnCollectClassClicked" OpensOptions="True"
                                                 ToolTip="Recolhe o que os alunos colocaram em &quot;Entregar ao professor&quot;." />
                            <!-- Wider than the shared 64 so "Pasta da turma" (76px) stays on one line: while a
                                 lesson is on, the class's name (Caption) takes the label's second line. -->
                            <local:ToolbarButton x:Name="ClassFolderButton" Content="Pasta da turma" Icon="&#xE8F7;" Width="84"
                                                 local:DeviceActions.Action="ClassFolder" Click="OnClassFolderClicked" OpensOptions="True"
                                                 ToolTip="Escolhe a turma da aula: o que os alunos baixarem ou salvarem na pasta da turma aparece em todos os computadores." />
                        </StackPanel>
                        <ContentControl Content="Turma" Style="{StaticResource ToolbarGroupCaption}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ToolbarGroupPanel}" local:ToolbarButton.IconBrush="{StaticResource ProgramasBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <local:ToolbarButton Content="Abrir site" Icon="&#xE774;" local:DeviceActions.Action="OpenWebsite" Click="OnOpenWebsiteClassClicked" OpensOptions="True"
                                                 ToolTip="Abre um site no navegador da turma toda." />
                            <local:ToolbarButton Content="Abrir programa" Icon="&#xE756;" local:DeviceActions.Action="OpenProgram" Click="OnOpenProgramClassClicked" OpensOptions="True"
                                                 ToolTip="Abre um programa na turma toda, como o Executar do Windows (ex.: powershell)." />
                            <local:ToolbarButton Content="Instalar programa" Icon="&#xE7B8;" local:DeviceActions.Action="Install" Click="OnInstallClassClicked" OpensOptions="True"
                                                 ToolTip="Instala um programa na turma toda, como administrador, sem a tela do UAC e sem digitar senha." />
                            <local:ToolbarButton Content="Desinstalar programa" Icon="&#xE74D;" local:DeviceActions.Action="Uninstall" Click="OnUninstallClassClicked" OpensOptions="True"
                                                 ToolTip="Desinstala programas das máquinas da turma (lista a partir de uma máquina)." />
                            <local:ToolbarButton Content="Fechar programas" Icon="&#xE711;" local:DeviceActions.Action="CloseApps" Click="OnCloseAppsClassClicked" OpensOptions="True"
                                                 ToolTip="Fecha os programas abertos pelos alunos, depois de avisá-los." />
                            <local:ToolbarButton Content="Bloquear programas" Icon="&#xECAA;" Badge="&#xE733;" local:DeviceActions.Action="BlockPrograms" Click="OnBlockAppsClassClicked" OpensOptions="True"
                                                 ToolTip="Impede programas de abrir nas máquinas da turma. Com só celulares selecionados, ou no filtro Celulares, bloqueia apps nos celulares." />
                            <local:ToolbarButton Content="Bloquear sites" Icon="&#xE774;" Badge="&#xE733;" local:DeviceActions.Action="BlockSites" Click="OnSiteBlockClassClicked" OpensOptions="True"
                                                 ToolTip="Bloqueia a internet inteira ou alguns sites na turma, celulares também. Com só celulares selecionados, ou no filtro Celulares, vale só para eles." />
                        </StackPanel>
                        <ContentControl Content="Programas e sites" Style="{StaticResource ToolbarGroupCaption}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ToolbarGroupPanel}" local:ToolbarButton.IconBrush="{StaticResource ConfigurarBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <local:ToolbarButton Content="Painel do laboratório" Icon="&#xE713;" local:DeviceActions.Action="LabConfig" Click="OnLabConfigClassClicked" OpensOptions="True"
                                                 ToolTip="Configura o navegador e o Windows dos alunos: limpeza, blindagem, Edge, sites de distração, travas (barra de tarefas, Área de Trabalho e downloads) e limpar os perfis do Chrome." />
                            <local:ToolbarButton Content="Máquinas da sala" Icon="&#xE7F8;" Click="OnMachinesClicked" OpensOptions="True"
                                                 ToolTip="Procura e pareia as máquinas, atualiza o programa dos alunos, dá a sala a um colega ou entra na sala dele, permite outro professor e tem os ajustes avançados." />
                        </StackPanel>
                        <ContentControl Content="Configurar" Style="{StaticResource ToolbarGroupCaption}" />
                    </StackPanel>
                </Border>
            </WrapPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0" Padding="14,7">
            <DockPanel>
                <!-- How big each machine's screen is drawn (TileSize, remembered in
                     GridViewFile); also Ctrl + the mouse wheel and Ctrl +, -, 0. -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <!-- TileArrangement: the tiles where the machines are in the room. -->
                    <ToggleButton x:Name="ArrangeButton" Content="Organizar sala" Click="OnArrangeClicked" Padding="10,2" FontSize="12"
                                  Style="{StaticResource FilterToggleButton}"
                                  ToolTip="Ligado, você arrasta as telas para ficarem como as máquinas estão na sala. As posições ficam guardadas." />
                    <Button x:Name="AlignButton" Content="Alinhar" Click="OnAlignClicked" Padding="10,2" FontSize="12" Margin="6,0,0,0"
                            Visibility="Collapsed" ToolTip="Encaixa cada tela na posição inteira mais próxima, sem sobrepor." />
                    <ToggleButton x:Name="FitAllButton" Content="Visualizar todos" Click="OnFitAllClicked" Padding="10,2" FontSize="12"
                                  Margin="12,0,0,0" Style="{StaticResource FilterToggleButton}"
                                  ToolTip="Ligado, mantém todas as máquinas mostradas na janela, sem rolar: as telas mudam de tamanho sozinhas quando a janela muda ou quando máquinas aparecem e somem. Mudar o tamanho à mão desliga." />
                    <!-- GridFilter: hides the machines that are off or not answering. -->
                    <ToggleButton x:Name="OnlineOnlyButton" Content="Só online" Click="OnOnlineOnlyClicked" Padding="10,2" FontSize="12"
                                  Margin="6,0,0,0" Style="{StaticResource FilterToggleButton}"
                                  ToolTip="Mostra só as máquinas ligadas e respondendo; as desligadas ou sem resposta saem da grade. As ações para a turma toda continuam valendo para todas as máquinas." />
                    <Button Click="OnSmallerTilesClicked" Padding="6,3" Margin="12,0,6,0"
                            ToolTip="Telas menores, para ver mais máquinas de uma vez (Ctrl + roda do mouse ou Ctrl -).">
                        <TextBlock Text="&#xE71F;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                    </Button>
                    <Slider x:Name="TileSizeSlider" Width="140" VerticalAlignment="Center" SmallChange="8" LargeChange="32"
                            ToolTip="Tamanho das telas dos alunos (Ctrl + roda do mouse)." />
                    <Button Click="OnLargerTilesClicked" Padding="6,3" Margin="6,0,0,0"
                            ToolTip="Telas maiores, para ver melhor cada máquina (Ctrl + roda do mouse ou Ctrl +).">
                        <TextBlock Text="&#xE8A3;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                    </Button>
                </StackPanel>
                <TextBlock x:Name="StatusTextBlock" Foreground="{StaticResource TextMutedBrush}" FontSize="13" TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- DeviceFilter: all the machines, only the computers or only the phones. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BackgroundBrush}" Padding="14,0,14,6">
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="AllDevicesButton" Content="Todos" Click="OnAllDevicesClicked" Padding="10,2" FontSize="12"
                              Style="{StaticResource FilterToggleButton}"
                              ToolTip="Mostra computadores e celulares." />
                <ToggleButton x:Name="ComputersButton" Content="Computadores" Click="OnComputersClicked" Padding="10,2" FontSize="12"
                              Margin="6,0,0,0" Style="{StaticResource FilterToggleButton}"
                              ToolTip="Mostra só os computadores." />
                <ToggleButton x:Name="PhonesButton" Content="Celulares" Click="OnPhonesClicked" Padding="10,2" FontSize="12"
                              Margin="6,0,0,0" Style="{StaticResource FilterToggleButton}"
                              ToolTip="Mostra só os celulares. Os celulares ficam de fora das ações que ainda não funcionam neles." />
            </StackPanel>
        </Border>

        <Grid Background="{StaticResource BackgroundBrush}">
            <StackPanel x:Name="EmptyRosterPanel" Visibility="Collapsed" Panel.ZIndex="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE7F8;" FontFamily="{StaticResource IconFont}" FontSize="40" HorizontalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12" />
                <TextBlock FontSize="14" TextAlignment="Center" Foreground="{StaticResource TextMutedBrush}"
                           Text="Nenhuma máquina na sala ainda.&#x0a;Instale o Midview Aluno nas máquinas e procure-as na rede,&#x0a;ou peça um código a um colega que já tem a sala." />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Button Content="Procurar máquinas na rede" Click="OnSearchNetworkClicked" Padding="16,7"
                            Style="{StaticResource PrimaryButton}" />
                    <Button Content="Entrar na sala de um colega" Click="OnJoinClassClicked" Padding="16,7" Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>
            <!-- "Só online" hiding every machine (GridFilter.EmptyNotice). -->
            <StackPanel x:Name="NoneShownPanel" Visibility="Collapsed" Panel.ZIndex="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE7F8;" FontFamily="{StaticResource IconFont}" FontSize="40" HorizontalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12" />
                <TextBlock x:Name="NoneShownText" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="520"
                           Foreground="{StaticResource TextMutedBrush}" />
                <Button Content="Mostrar todas as máquinas" Click="OnShowAllMachinesClicked" Padding="16,7" Margin="0,12,0,0"
                        HorizontalAlignment="Center" />
            </StackPanel>
            <!-- No focus rectangle: the grid takes keyboard focus on Esc and on a
                 press in the empty space (so no tile keeps a focus border), and a
                 dotted line around the whole grid would read as a selection. -->
            <ScrollViewer x:Name="MachinesScrollViewer" VerticalScrollBarVisibility="Auto" ScrollChanged="OnMachinesScrolled"
                          SizeChanged="OnMachinesScrollViewerSizeChanged" FocusVisualStyle="{x:Null}">
                <!-- The scroll bar lies along the window's right edge: inside the 6 px
                     resize band it would otherwise resize the window instead of scrolling. -->
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
                        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
                    </Style>
                </ScrollViewer.Resources>
                <!-- Transparent rather than no background, so a press on the space
                     between and around the tiles reaches it and can start a selection
                     rectangle; the tiles, being buttons, take their own presses. It is
                     inside the ScrollViewer with the tiles, so the rectangle (drawn on
                     the Canvas above them) scrolls with them. -->
                <Grid x:Name="GridSurface" Background="Transparent"
                      MouseLeftButtonDown="OnGridSurfaceMouseDown" MouseMove="OnGridSurfaceMouseMove"
                      MouseLeftButtonUp="OnGridSurfaceMouseUp" LostMouseCapture="OnGridSurfaceLostCapture"
                      PreviewMouseMove="OnGridSurfacePreviewMouseMove" PreviewMouseLeftButtonUp="OnGridSurfacePreviewMouseUp">
                    <ItemsControl x:Name="MachinesItemsControl" Margin="10" SizeChanged="OnMachinesItemsSizeChanged">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <local:TileGridPanel Loaded="OnTilePanelLoaded" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <!-- Where each tile sits when placed like the room ("Organizar sala"). -->
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="local:TileGridPanel.Cell" Value="{Binding Cell}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource MachineTileButton}" Click="OnMachineClicked"
                                        MouseDoubleClick="OnMachineDoubleClicked"
                                        PreviewMouseLeftButtonDown="OnTilePressed"
                                        PreviewMouseRightButtonDown="OnMachineRightClicked" ContextMenuOpening="OnMachineMenuOpening"
                                        ToolTip="Clique para selecionar, dois cliques para ver a tela. Botão direito para mais opções.">
                                    <Button.ContextMenu>
                                        <!-- With several machines selected (OnMachineMenuOpening) the items
                                             tagged "varias" show, those tagged "uma" (one machine only) hide,
                                             and the rest act on all of them. -->
                                        <ContextMenu>
                                            <!-- "N máquinas selecionadas": a heading, not an item. It stays enabled so it
                                                 reads in full text, but the mouse and the arrow keys pass over it. -->
                                            <MenuItem Tag="varias" Focusable="False" IsHitTestVisible="False" FontWeight="SemiBold" Visibility="Collapsed" />
                                            <Separator Tag="varias" Visibility="Collapsed" />
                                            <!-- Energia first, as on the toolbar. -->
                                            <MenuItem Header="Desligar..." local:DeviceActions.Action="Power" Click="OnPowerMachineClicked" />
                                            <MenuItem Header="Reiniciar..." local:DeviceActions.Action="Power" Click="OnRestartMachineClicked" />
                                            <MenuItem Header="Ligar" local:DeviceActions.Action="Wake" Click="OnWakeMachineClicked" />
                                            <Separator />
                                            <MenuItem Tag="uma" Header="Ver a tela" local:DeviceActions.Action="View" Click="OnViewMachineClicked" />
                                            <MenuItem Tag="uma" Header="Controlar (trava o teclado e o mouse do aluno)" local:DeviceActions.Action="Control" Click="OnControlMachineClicked" />
                                            <!-- Only for phones: shown by OnMachineMenuOpening when one is among the machines. -->
                                            <MenuItem Tag="celular" Header="Pedir de novo para ver a tela" Visibility="Collapsed" Click="OnAskScreenAgainClicked" />
                                            <!-- "Bloquear a tela" or "Desbloquear a tela", as OnMachineMenuOpening finds the machines. -->
                                            <MenuItem Tag="bloqueio" Header="Bloquear a tela" local:DeviceActions.Action="ScreenLock" Click="OnScreenLockMachineClicked" />
                                            <Separator />
                                            <MenuItem Header="Enviar mensagem..." local:DeviceActions.Action="Message" Click="OnMessageMachineClicked" />
                                            <MenuItem Tag="uma" Header="Conversar (chat)..." local:DeviceActions.Action="Chat" Click="OnChatMachineClicked" />
                                            <MenuItem Header="Enviar arquivo..." local:DeviceActions.Action="SendFile" Click="OnFileMachineClicked" />
                                            <MenuItem Header="Recolher arquivos..." local:DeviceActions.Action="CollectFiles" Click="OnCollectMachineClicked" />
                                            <!-- Filled with the saved items when opened (MainWindow.LaunchMenu.cs). -->
                                            <MenuItem local:DeviceActions.Action="OpenWebsite" Header="Abrir site" SubmenuOpened="OnWebsiteSubmenuOpened" PreviewKeyDown="OnWebsiteSubmenuKeyDown">
                                                <MenuItem Header="Outro site..." Click="OnOpenWebsiteMachineClicked" />
                                            </MenuItem>
                                            <MenuItem local:DeviceActions.Action="OpenProgram" Header="Abrir programa" SubmenuOpened="OnProgramSubmenuOpened" PreviewKeyDown="OnProgramSubmenuKeyDown">
                                                <MenuItem Header="Outro programa..." Click="OnOpenProgramMachineClicked" />
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="Fechar programas..." local:DeviceActions.Action="CloseApps" Click="OnCloseAppsMachineClicked" />
                                            <MenuItem Header="Bloquear programas..." local:DeviceActions.Action="BlockPrograms" Click="OnBlockAppsMachineClicked" />
                                            <MenuItem Header="Bloquear sites..." local:DeviceActions.Action="BlockSites" Click="OnSiteBlockMachineClicked" />
                                            <MenuItem Header="Painel do laboratório..." local:DeviceActions.Action="LabConfig" Click="OnLabConfigMachineClicked" />
                                            <MenuItem Header="Instalar programa..." local:DeviceActions.Action="Install" Click="OnInstallMachineClicked" />
                                            <MenuItem Tag="uma" Header="Desinstalar programa..." local:DeviceActions.Action="Uninstall" Click="OnUninstallMachineClicked" />
                                            <!-- "uma" too: with only "uma" items after it, it would end the menu. -->
                                            <Separator Tag="uma" />
                                            <MenuItem Tag="uma" Header="Editar a máquina (avançado)..." Click="OnEditMachineClicked" />
                                            <MenuItem Tag="uma" Header="Remover da lista da sala" Click="OnRemoveMachineClicked" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <!-- As wide as the teacher made the tiles (ShowTilesAt): the screen,
                                         then the machine's line under it, then any warnings. A long
                                         name or status is cut short rather than widening its tile. -->
                                    <StackPanel>
                                        <!-- A phone's tile stands up: same height as a PC's, narrower, rounder. -->
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Width" Value="{DynamicResource TileWidth}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPhone}" Value="True">
                                                        <Setter Property="Width" Value="{DynamicResource PhoneTileWidth}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Border Height="{DynamicResource TileHeight}" Background="{StaticResource BackgroundBrush}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPhone}" Value="True">
                                                            <Setter Property="CornerRadius" Value="12" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <!-- A brush, not an Image: it follows the rounded corners. -->
                                                <Border>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="8" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPhone}" Value="True">
                                                                    <Setter Property="CornerRadius" Value="12" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="Uniform" />
                                                    </Border.Background>
                                                </Border>
                                                <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center">
                                                    <!-- A phone's tile is narrow: smaller, one line, never cut inside a word. -->
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Margin" Value="10" />
                                                            <Setter Property="FontSize" Value="13" />
                                                            <Setter Property="TextWrapping" Value="Wrap" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPhone}" Value="True">
                                                                    <Setter Property="Margin" Value="2" />
                                                                    <Setter Property="FontSize" Value="10" />
                                                                    <Setter Property="TextWrapping" Value="NoWrap" />
                                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <!-- The screen is locked: a red pill over its corner, dark enough to
                                                     read over any screen; a muted "Bloqueando..." one while the lock
                                                     is still being put on. A lock that failed or that the student got
                                                     out of is a warning under the card instead. -->
                                                <Border x:Name="LockPill" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6"
                                                        Padding="8,2" CornerRadius="10" BorderThickness="1">
                                                    <TextBlock FontSize="10.5" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="🔒 Bloqueada" />
                                                                <Setter Property="Foreground" Value="#FFB4B4" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ScreenLockBadge}" Value="{x:Static local:ScreenLockText.Locking}">
                                                                        <Setter Property="Text" Value="{x:Static local:ScreenLockText.Locking}" />
                                                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#E6341C26" />
                                                            <Setter Property="BorderBrush">
                                                                <Setter.Value>
                                                                    <SolidColorBrush Color="#FF6B6B" Opacity="0.6" />
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ScreenLockBadge}" Value="{x:Static local:ScreenLockText.Locking}">
                                                                    <Setter Property="Background" Value="{StaticResource CardBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ScreenLockBadge}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ScreenLockAlert}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <!-- The machine's line: a dot for its state (answering, not, or its
                                             screen locked, once the machine says so), its name, and its
                                             short status at the right. -->
                                        <DockPanel Margin="4,5,4,1">
                                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource OfflineBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Presence}" Value="Online">
                                                                <Setter Property="Fill" Value="{StaticResource OnlineBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ScreenLockBadge}" Value="{x:Static local:ScreenLockText.Locked}">
                                                                <Setter Property="Fill" Value="{StaticResource EnergiaBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="6,0,0,0"
                                                       HorizontalAlignment="Right" TextAlignment="Right" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center">
                                                <!-- A phone's tile is narrow: the screen already says it, the name gets the line. -->
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPhone}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DockPanel>
                                        <TextBlock Text="{Binding ScreenLockBadge}" FontSize="11" HorizontalAlignment="Center" Margin="4,3,4,2"
                                                   TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ScreenLockAlert}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding BlockBadge}" FontSize="11" Foreground="{StaticResource ErrorBrush}" HorizontalAlignment="Center" Margin="4,3,4,2"
                                                   TextAlignment="Center" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BlockBadge}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Canvas IsHitTestVisible="False">
                        <Rectangle x:Name="SelectionBand" Visibility="Collapsed" StrokeThickness="1"
                                   Stroke="{StaticResource AccentBrush}" Fill="{StaticResource AccentSoftBrush}" />
                    </Canvas>
                </Grid>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</local:MidviewWindow>
