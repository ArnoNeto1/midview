<Window x:Class="Midview.Master.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Midview - Sala de aula" Height="720" Width="1180"
        Closed="OnWindowClosed">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="#FF2D2D30">
            <Button Content="Adicionar / testar máquina" Click="OnAddMachineClicked" Padding="10,4" Margin="4" />
            <Button Content="Instalar nos alunos..." Click="OnLabInstallClicked" Padding="10,4" Margin="4" />
            <Button Content="Enviar mensagem para a turma" Click="OnMessageClassClicked" Padding="10,4" Margin="4" />
            <Button Content="Enviar arquivo para a turma" Click="OnFileClassClicked" Padding="10,4" Margin="4" />
            <Button Content="Recolher arquivos da turma" Click="OnCollectClassClicked" Padding="10,4" Margin="4" />
            <Button Content="Fechar programas da turma" Click="OnCloseAppsClassClicked" Padding="10,4" Margin="4" />
        </StackPanel>
        <TextBlock x:Name="StatusTextBlock" DockPanel.Dock="Bottom" Margin="8,4" TextWrapping="Wrap" />
        <Grid Background="#FFF0F0F0">
            <TextBlock x:Name="EmptyRosterTextBlock" Visibility="Collapsed"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Foreground="Gray"
                       Text="Nenhuma máquina na lista da sala ainda.&#x0a;Use &quot;Adicionar / testar máquina&quot; para testar uma máquina e salvá-la aqui." />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="MachinesItemsControl" Margin="6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="6" Padding="4" Click="OnMachineClicked"
                                    ToolTip="Clique para abrir o controle total. Botão direito para mais opções.">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Enviar mensagem..." Click="OnMessageMachineClicked" />
                                        <MenuItem Header="Conversar (chat)..." Click="OnChatMachineClicked" />
                                        <MenuItem Header="Enviar arquivo..." Click="OnFileMachineClicked" />
                                        <MenuItem Header="Recolher arquivos..." Click="OnCollectMachineClicked" />
                                        <MenuItem Header="Fechar programas..." Click="OnCloseAppsMachineClicked" />
                                        <MenuItem Header="Testar / bloquear sites..." Click="OnEditMachineClicked" />
                                        <MenuItem Header="Remover da lista da sala" Click="OnRemoveMachineClicked" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <StackPanel>
                                    <Grid Width="256" Height="144" Background="Black">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                        <TextBlock Text="{Binding Status}" Foreground="White" Margin="8"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   TextAlignment="Center" TextWrapping="Wrap" />
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,4,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
