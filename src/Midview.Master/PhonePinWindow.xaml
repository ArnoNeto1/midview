<local:MidviewWindow x:Class="Midview.Master.PhonePinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Midview.Master"
        Title="Senha dos celulares e tablets" Height="640" Width="640" MinHeight="460" MinWidth="520"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=PinPasswordBox}">
    <DockPanel Margin="24,22,24,20">
        <StackPanel DockPanel.Dock="Top">
            <local:DialogHeader x:Name="DialogHeading" Icon="&#xE72E;" Heading="Senha dos celulares e tablets" Accent="{StaticResource CelularesBrush}">
                <TextBlock x:Name="TargetsTextBlock" Style="{StaticResource Hint}" />
            </local:DialogHeader>
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                               Text="Põe um PIN de 4 números na tela de bloqueio. O aluno não consegue trocar nem tirar o PIN: se tentar, o Midview põe o do professor de volta. Para pôr, trocar ou tirar o PIN, use esta janela, não o celular." />
                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="Um celular que já tinha uma trava de tela precisa ser desbloqueado uma vez antes. Os preparados antes da versão 0.0.57 precisam ser reiniciados uma vez. O PIN não fica guardado neste computador: anote-o." />
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <TextBlock Text="PIN" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" />
                <Grid Width="96">
                    <PasswordBox x:Name="PinPasswordBox" MaxLength="4" FontSize="18" Padding="10,5"
                                 InputScope="Number" AutomationProperties.Name="PIN"
                                 PasswordChanged="OnPinPasswordChanged" PreviewTextInput="OnPinPreviewTextInput" PreviewKeyDown="OnPinPreviewKeyDown" />
                    <TextBox x:Name="PinTextBox" MaxLength="4" FontSize="18" Padding="10,5" Visibility="Collapsed"
                             InputScope="Number" AutomationProperties.Name="PIN"
                             TextChanged="OnPinTextChanged" PreviewTextInput="OnPinPreviewTextInput" PreviewKeyDown="OnPinPreviewKeyDown" />
                </Grid>
                <CheckBox x:Name="ShowPinCheckBox" Content="Mostrar" VerticalAlignment="Center" Margin="14,0,0,0"
                          Checked="OnShowPinChanged" Unchecked="OnShowPinChanged" />
                <TextBlock x:Name="PinHintTextBlock" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="14,0,0,0" />
            </StackPanel>
            <DockPanel Margin="0,14,0,10">
                <Button x:Name="SetButton" DockPanel.Dock="Left" Content="Pôr o PIN" Click="OnSetClicked"
                        Style="{StaticResource PrimaryButton}" Padding="14,6" Margin="0,0,8,0" IsEnabled="False" IsDefault="True" />
                <Button x:Name="RemoveButton" DockPanel.Dock="Left" Content="Tirar o PIN" Click="OnRemoveClicked"
                        Padding="14,6" Margin="0,0,12,0" />
                <TextBlock x:Name="ProgressTextBlock" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="PhonesList" ItemTemplate="{StaticResource PhoneRowTemplate}" />
        </ScrollViewer>
    </DockPanel>
</local:MidviewWindow>
