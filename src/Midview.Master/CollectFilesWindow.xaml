<local:MidviewWindow x:Class="Midview.Master.CollectFilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Midview.Master"
        Title="Recolher arquivos" Height="680" Width="580" MinHeight="540"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="24,22,24,20">
        <StackPanel DockPanel.Dock="Top">
            <local:DialogHeader Icon="&#xE896;" Heading="Recolher arquivos" Accent="{StaticResource TurmaBrush}">
                <TextBlock x:Name="TargetsTextBlock" Style="{StaticResource Hint}" />
            </local:DialogHeader>
            <Border Style="{StaticResource Card}" Margin="0,16,0,10">
                <StackPanel>
                    <TextBlock Text="Recolher" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                    <TextBlock x:Name="CollectHintTextBlock" Style="{StaticResource Hint}" Margin="0,0,0,10"
                               Text="Traz o que cada aluno colocou na pasta &quot;Entregar ao professor&quot; da Área de Trabalho (subpastas também). Os arquivos continuam no aluno, que recebe um aviso. Até 1000 arquivos e 500 MB por máquina." />
                    <DockPanel>
                        <Button x:Name="OpenFolderButton" DockPanel.Dock="Right" Content="Abrir pasta" Click="OnOpenFolderClicked"
                                IsEnabled="False" Padding="14,6" Margin="8,0,0,0" />
                        <Button x:Name="CollectButton" Content="Recolher" Click="OnCollectClicked"
                                Style="{StaticResource PrimaryButton}" Padding="14,6" />
                    </DockPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Para começar a próxima aula" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                    <TextBlock x:Name="ClearHintTextBlock" Style="{StaticResource Hint}" Margin="0,0,0,10"
                               Text="Para começar a próxima aula com tudo vazio. Os arquivos vão para a Lixeira, de onde ainda podem ser recuperados." />
                    <DockPanel>
                        <Button x:Name="ClearCollectedButton" DockPanel.Dock="Right" Content="Apagar os recolhidos neste PC"
                                Click="OnClearCollectedClicked" Style="{StaticResource DangerButton}" Padding="14,6" Margin="8,0,0,0" />
                        <Button x:Name="ClearStudentsButton" Content="Apagar as pastas dos alunos" Click="OnClearStudentsClicked"
                                Style="{StaticResource DangerButton}" Padding="14,6" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        <Border Style="{StaticResource ResultCard}">
            <DockPanel>
                <TextBlock x:Name="ProgressTextBlock" DockPanel.Dock="Top" TextWrapping="Wrap" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ResultTextBlock" TextWrapping="Wrap" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</local:MidviewWindow>
