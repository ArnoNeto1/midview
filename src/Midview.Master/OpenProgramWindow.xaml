<Window x:Class="Midview.Master.OpenProgramWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Abrir programa" Height="540" Width="520"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=CommandTextBox}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="TargetsTextBlock" TextWrapping="Wrap" FontWeight="Bold" Margin="0,0,0,8" />
            <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,8"
                       Text="Abre o programa na máquina do aluno, como o próprio aluno (sem ser administrador). Escreva como no Executar do Windows: powershell, notepad, chrome https://www.google.com. Um caminho com espaço vai entre aspas. Um programa bloqueado continua bloqueado." />
            <TextBlock Text="Comando (um programa por linha):" Margin="0,0,0,4" />
            <TextBox x:Name="CommandTextBox" Padding="4,3" MaxLength="2000" TextChanged="OnCommandChanged"
                     AcceptsReturn="True" MinHeight="64" MaxHeight="140"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
            <TextBlock x:Name="ProblemTextBlock" Foreground="#B3261E" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />
            <CheckBox x:Name="SaveCheckBox" Content="Salvar no menu" Margin="0,12,0,0"
                      Checked="OnSaveChanged" Unchecked="OnSaveChanged"
                      ToolTip="Fica no menu do botão &quot;Abrir programa&quot;, para abrir com um clique da próxima vez." />
            <StackPanel x:Name="NamePanel" Orientation="Horizontal" Margin="22,6,0,0" IsEnabled="False">
                <TextBlock Text="Nome no menu:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="NameTextBox" Width="220" Padding="4,3" MaxLength="60"
                         ToolTip="Em branco, o menu usa o nome do programa (por exemplo, powershell)." />
            </StackPanel>
            <Button x:Name="OpenButton" Content="Abrir nas máquinas" Click="OnOpenClicked"
                    Padding="10,4" Margin="0,12,0,0" HorizontalAlignment="Left" />
            <TextBlock x:Name="ProgressTextBlock" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
            <TextBlock x:Name="ResultTextBlock" TextWrapping="Wrap" />
        </ScrollViewer>
    </DockPanel>
</Window>
