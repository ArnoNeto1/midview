<local:MidviewWindow x:Class="Midview.Master.OpenProgramWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Midview.Master"
        Title="Abrir programa" Height="660" Width="540" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=CommandTextBox}">
    <DockPanel Margin="24,22,24,20">
        <StackPanel DockPanel.Dock="Top">
            <local:DialogHeader Icon="&#xE756;" Heading="Abrir programa" Accent="{StaticResource ProgramasBrush}">
                <TextBlock x:Name="TargetsTextBlock" Style="{StaticResource Hint}" />
            </local:DialogHeader>
            <Border Style="{StaticResource Card}" Margin="0,16,0,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                               Text="Abre o programa na máquina do aluno, como o próprio aluno (sem ser administrador). Escreva como no Executar do Windows: powershell, notepad, chrome https://www.google.com. Um caminho com espaço vai entre aspas. Um programa bloqueado continua bloqueado." />
                    <TextBlock Text="Comando (um programa por linha):" Margin="0,0,0,4" />
                    <TextBox x:Name="CommandTextBox" Padding="4,3" MaxLength="2000" TextChanged="OnCommandChanged"
                             AcceptsReturn="True" MinHeight="64" MaxHeight="140"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    <TextBlock x:Name="ProblemTextBlock" Style="{StaticResource ErrorText}" Margin="0,4,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <CheckBox x:Name="SaveCheckBox" Content="Salvar no menu"
                              Checked="OnSaveChanged" Unchecked="OnSaveChanged"
                              ToolTip="Fica no menu do botão &quot;Abrir programa&quot;, para abrir com um clique da próxima vez." />
                    <StackPanel x:Name="NamePanel" Orientation="Horizontal" Margin="24,8,0,0" IsEnabled="False">
                        <TextBlock Text="Nome no menu:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="NameTextBox" Width="220" Padding="4,3" MaxLength="60"
                                 ToolTip="Em branco, o menu usa o nome do programa (por exemplo, powershell)." />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Button x:Name="OpenButton" Content="Abrir nas máquinas" Click="OnOpenClicked"
                    Style="{StaticResource PrimaryButton}" Padding="14,6" Margin="0,0,0,10" HorizontalAlignment="Left" />
        </StackPanel>
        <Border Style="{StaticResource ResultCard}">
            <DockPanel>
                <TextBlock x:Name="ProgressTextBlock" DockPanel.Dock="Top" TextWrapping="Wrap" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ResultTextBlock" TextWrapping="Wrap" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</local:MidviewWindow>
