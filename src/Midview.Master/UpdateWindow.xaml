<local:MidviewWindow x:Class="Midview.Master.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Midview.Master"
        Title="Atualizar pela rede" Height="660" Width="680"
        WindowStartupLocation="CenterOwner" Closing="OnClosing">
    <DockPanel Margin="24,22,24,20">
        <StackPanel DockPanel.Dock="Top">
            <local:DialogHeader Icon="&#xE895;" Heading="Atualizar pela rede" Accent="{StaticResource ConfigurarBrush}">
                <TextBlock x:Name="PackageTextBlock" TextWrapping="Wrap" />
            </local:DialogHeader>
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock x:Name="BuildTextBlock" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8" Text="Lendo o pacote..." />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Atualiza o programa dos alunos pela rede: uma máquina primeiro, e as outras só depois que ela confirmar que a versão nova funciona; se não funcionar, ela volta sozinha para a anterior. Por 1 a 3 minutos você perde a visão e o controle de cada máquina; os alunos podem continuar usando o computador, mas mensagens e conversas abertas fecham e o teclado e o mouse são destravados. Não desligue as máquinas até terminar. Os professores que cada máquina aceita não mudam. Uma máquina com um Midview anterior a esta função precisa ser atualizada uma vez com o MidviewSetup." />
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button x:Name="CheckButton" Content="Verificar versões" Click="OnCheckClicked" Padding="14,6" Margin="0,0,8,0" IsEnabled="False" />
                <Button x:Name="UpdateButton" Content="Atualizar" Click="OnUpdateClicked" Style="{StaticResource PrimaryButton}" Padding="14,6" Margin="0,0,8,0" IsEnabled="False" />
                <Button x:Name="StopButton" Content="Parar" Click="OnStopClicked" Style="{StaticResource DangerButton}" Padding="14,6" IsEnabled="False"
                        ToolTip="Não começa mais nenhuma máquina; as que já estão trocando de versão terminam." />
            </StackPanel>
            <TextBlock x:Name="ProgressTextBlock" Margin="0,10,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="WarningTextBlock" Margin="0,4,0,0" Style="{StaticResource WarningText}" />
        </StackPanel>
        <Border Style="{StaticResource ResultCard}" Margin="0,12,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="ResultTextBlock" TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>
    </DockPanel>
</local:MidviewWindow>
