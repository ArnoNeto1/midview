<Window x:Class="Midview.Master.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atualizar pela rede" Height="620" Width="660"
        WindowStartupLocation="CenterOwner" Closing="OnClosing">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="PackageTextBlock" FontWeight="Bold" TextWrapping="Wrap" />
            <TextBlock x:Name="BuildTextBlock" TextWrapping="Wrap" Margin="0,4,0,8" Text="Lendo o pacote..." />
            <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,8"
                       Text="Atualiza o programa dos alunos pela rede: uma máquina primeiro, e as outras só depois que ela confirmar que a versão nova funciona; se não funcionar, ela volta sozinha para a anterior. Por 1 a 3 minutos você perde a visão e o controle de cada máquina; os alunos podem continuar usando o computador, mas mensagens e conversas abertas fecham e o teclado e o mouse são destravados. Não desligue as máquinas até terminar. Os professores que cada máquina aceita não mudam. Uma máquina com um Midview anterior a esta função precisa ser atualizada uma vez com o Midview-Instalador." />
            <StackPanel Orientation="Horizontal">
                <Button x:Name="CheckButton" Content="Verificar versões" Click="OnCheckClicked" Padding="10,4" Margin="0,0,8,0" IsEnabled="False" />
                <Button x:Name="UpdateButton" Content="Atualizar" Click="OnUpdateClicked" Padding="10,4" Margin="0,0,8,0" IsEnabled="False" />
                <Button x:Name="StopButton" Content="Parar" Click="OnStopClicked" Padding="10,4" IsEnabled="False"
                        ToolTip="Não começa mais nenhuma máquina; as que já estão trocando de versão terminam." />
            </StackPanel>
            <TextBlock x:Name="ProgressTextBlock" Margin="0,8,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="WarningTextBlock" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#B3261E" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
            <TextBlock x:Name="ResultTextBlock" TextWrapping="Wrap" />
        </ScrollViewer>
    </DockPanel>
</Window>
