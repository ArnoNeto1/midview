<Window x:Class="Midview.Master.MachinesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Máquinas da sala" Height="740" Width="780"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}" FontFamily="{StaticResource UiFont}"
        Closed="OnClosed">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style x:Key="SectionHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
            <Setter Property="Margin" Value="0,1,0,4" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="16,12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Procurar e parear" Style="{StaticResource SectionTitle}" />
            <TextBlock Style="{StaticResource SectionHint}"
                       Text="Procura as máquinas nesta rede. Ao parear, confira se o código na tela do aluno é o mesmo daqui. Você tem 5 minutos para isso." />
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource InkMutedBrush}" FontSize="12">
                    <Run Text="Um colega já tem?" />
                    <Hyperlink Click="OnJoinClassClicked">Entrar na sala de um colega...</Hyperlink>
                </TextBlock>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="SearchButton" Content="Procurar na rede" Click="OnSearchClicked" Padding="10,4" />
                    <Button x:Name="PairButton" Content="Parear as selecionadas" Click="OnPairClicked" IsEnabled="False" Margin="8,0,0,0" Padding="10,4" />
                    <TextBlock x:Name="SearchStatusTextBlock" VerticalAlignment="Center" Margin="12,0,12,0"
                               TextWrapping="Wrap" Foreground="{StaticResource InkMutedBrush}" FontSize="12" />
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Border BorderBrush="{StaticResource CardLineBrush}" BorderThickness="0,1,0,0" Padding="0,7,0,0">
                <StackPanel>
                    <TextBlock Text="Atualizar as máquinas" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="StudentVersionTextBlock" Style="{StaticResource SectionHint}" />
                    <Button x:Name="UpdateButton" Content="Atualizar as máquinas pela rede..." Click="OnUpdateClicked" HorizontalAlignment="Left" Padding="10,4" />
                </StackPanel>
            </Border>
            <Border BorderBrush="{StaticResource CardLineBrush}" BorderThickness="0,1,0,0" Padding="0,7,0,0" Margin="0,7,0,0">
                <StackPanel>
                    <TextBlock Text="Outro professor" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource SectionHint}"
                               Text="Dê um código a um colega (nada aparece na tela dos alunos) ou deixe as máquinas aceitarem o pareamento dele por 10 minutos." />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Dar acesso a um colega..." Click="OnGiveAccessClicked" Padding="10,4" />
                        <Button x:Name="AllowNewTeacherButton" Content="Permitir novo professor (10 minutos)" Click="OnAllowNewTeacherClicked" Margin="8,0,0,0" Padding="10,4" />
                    </StackPanel>
                    <TextBlock x:Name="AllowNewTeacherResultTextBlock" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border BorderBrush="{StaticResource CardLineBrush}" BorderThickness="0,1,0,0" Padding="0,7,0,0" Margin="0,7,0,0">
                <StackPanel>
                    <TextBlock Text="Avançado" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource SectionHint}"
                               Text="Identidade deste computador e adição manual de máquina (em outra rede, ou para corrigir o endereço)." />
                    <Button Content="Ajustes avançados..." Click="OnAdvancedClicked" HorizontalAlignment="Left" Padding="10,4" />
                </StackPanel>
            </Border>
            <Border BorderBrush="{StaticResource CardLineBrush}" BorderThickness="0,1,0,0" Padding="0,7,0,0" Margin="0,7,0,0">
                <StackPanel>
                    <TextBlock Text="Senha de administrador" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource SectionHint}"
                               Text="Guardada só neste PC (protegida pelo Windows) para preencher o UAC do aluno com um clique." />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="AdminPasswordButton" Content="Definir a senha..." Click="OnSetAdminPasswordClicked" Padding="10,4" />
                        <Button x:Name="RemoveAdminPasswordButton" Content="Remover" Click="OnRemoveAdminPasswordClicked" Margin="8,0,0,0" Padding="10,4" />
                        <TextBlock x:Name="AdminPasswordStatusTextBlock" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Foreground="{StaticResource InkMutedBrush}" FontSize="12" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
            <ItemsControl x:Name="FoundItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardLineBrush}"
                                BorderThickness="1" CornerRadius="5" Padding="10,5" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock FontSize="12" Margin="0,0,10,0">
                                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                        <Run Text="  " />
                                        <Run Text="{Binding Address, Mode=OneWay}" Foreground="{StaticResource InkMutedBrush}" />
                                        <Run Text="  •  " Foreground="{StaticResource CardLineHoverBrush}" />
                                        <Run Text="{Binding Status, Mode=OneWay}" Foreground="{StaticResource InkMutedBrush}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Outcome}" FontSize="12" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OutcomeIsError}" Value="True">
                                                        <Setter Property="Foreground" Value="#B3261E" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Outcome}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </WrapPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CodeText}" FontFamily="Consolas" FontSize="17" FontWeight="Bold"
                                               Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" Margin="8,0,10,0"
                                               Visibility="{Binding AwaitingConfirmation, Converter={StaticResource VisibleWhenTrue}}" />
                                    <Button Content="Confere" Click="OnConfirmClicked" Padding="8,2" Margin="0,0,4,0"
                                            Visibility="{Binding AwaitingConfirmation, Converter={StaticResource VisibleWhenTrue}}" />
                                    <Button Content="Não confere" Click="OnMismatchClicked" Padding="8,2"
                                            Visibility="{Binding AwaitingConfirmation, Converter={StaticResource VisibleWhenTrue}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
