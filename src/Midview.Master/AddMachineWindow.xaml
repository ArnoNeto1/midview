<local:MidviewWindow x:Class="Midview.Master.AddMachineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Midview.Master"
        Title="Configurações avançadas" Height="690" Width="500"
        WindowStartupLocation="CenterOwner">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,22,24,20">
            <local:DialogHeader Icon="&#xE713;" Heading="Ajustes avançados" Accent="{StaticResource ConfigurarBrush}" />

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Este PC de professor" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                    <TextBlock Text="Thumbprint deste MidviewMaster (as máquinas passam a aceitá-lo quando você as pareia em &quot;Máquinas da sala&quot;):" Margin="0,0,0,4" TextWrapping="Wrap" />
                    <TextBox x:Name="MyThumbprintTextBlock" IsReadOnly="True" Margin="0,0,0,8" />
                    <TextBlock Text="Para autorizar o PC de outro professor como este mesmo Master, copie este arquivo para o mesmo caminho lá (mesmo thumbprint, nenhuma máquina do laboratório precisa ser alterada):" Margin="0,0,0,4" Style="{StaticResource Hint}" />
                    <TextBox x:Name="KeyFilePathTextBlock" IsReadOnly="True" FontSize="11" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Adicionar ou editar uma máquina à mão" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                               Text="Normalmente as máquinas entram por &quot;Máquinas da sala&quot; &gt; &quot;Procurar na rede&quot;. Use isto só para uma máquina em outra rede, ou para corrigir o endereço de uma máquina." />
                    <TextBlock Text="Nome na sala (ex.: Aluno-25):" Margin="0,0,0,4" />
                    <TextBox x:Name="NameTextBox" Margin="0,0,0,8" TextChanged="OnRosterFieldChanged" />
                    <TextBlock Text="Endereço da máquina:" Margin="0,0,0,4" />
                    <TextBox x:Name="HostAddressTextBox" Margin="0,0,0,8" TextChanged="OnRosterFieldChanged" />
                    <TextBlock Text="Thumbprint da Session (na ficha da máquina, na pasta maquinas do pacote de instalação, ou no agent.log da máquina):" Margin="0,0,0,4" TextWrapping="Wrap" />
                    <TextBox x:Name="ThumbprintTextBox" Margin="0,0,0,8" TextChanged="OnRosterFieldChanged" />
                    <TextBlock Text="Thumbprint do Agent (na mesma ficha; sem ele não dá para bloquear sites e programas, desligar nem atualizar a máquina):" Margin="0,0,0,4" TextWrapping="Wrap" />
                    <TextBox x:Name="AgentThumbprintTextBox" Margin="0,0,0,10" />
                    <Button Content="Testar a conexão (abre a tela, só para ver)" Click="OnConnectClicked" HorizontalAlignment="Left" Padding="14,6" />
                    <TextBlock x:Name="ConnectStatusTextBlock" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Button x:Name="SaveButton" Content="Salvar na lista da sala" Click="OnSaveClicked" IsEnabled="False"
                    Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Padding="16,6" Margin="0,14,0,0" />
            <TextBlock x:Name="SaveStatusTextBlock" Margin="0,6,0,0" Style="{StaticResource Hint}" />
        </StackPanel>
    </ScrollViewer>
</local:MidviewWindow>
