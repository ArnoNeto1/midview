<Window x:Class="Midview.Master.AddMachineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações avançadas" Height="620" Width="460"
        WindowStartupLocation="CenterOwner">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="Este PC de professor" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Text="Thumbprint deste MidviewMaster (as máquinas passam a aceitá-lo quando você as pareia em &quot;Máquinas da sala&quot;):" Margin="0,0,0,4" TextWrapping="Wrap" />
            <TextBox x:Name="MyThumbprintTextBlock" IsReadOnly="True" Margin="0,0,0,8" />
            <TextBlock Text="Para autorizar o PC de outro professor como este mesmo Master, copie este arquivo para o mesmo caminho lá (mesmo thumbprint, nenhuma máquina do laboratório precisa ser alterada):" Margin="0,0,0,4" TextWrapping="Wrap" FontSize="11" Foreground="Gray" />
            <TextBox x:Name="KeyFilePathTextBlock" IsReadOnly="True" Margin="0,0,0,8" FontSize="11" />

            <Separator Margin="0,8,0,12" />

            <TextBlock Text="Adicionar ou editar uma máquina à mão" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,8"
                       Text="Normalmente as máquinas entram por &quot;Máquinas da sala&quot; &gt; &quot;Procurar na rede&quot;. Use isto só para uma máquina em outra rede, ou para corrigir o endereço de uma máquina." />
            <TextBlock Text="Nome na sala (ex.: Aluno-25):" Margin="0,0,0,4" />
            <TextBox x:Name="NameTextBox" Margin="0,0,0,8" TextChanged="OnRosterFieldChanged" />
            <TextBlock Text="Endereço da máquina:" Margin="0,0,0,4" />
            <TextBox x:Name="HostAddressTextBox" Margin="0,0,0,8" TextChanged="OnRosterFieldChanged" />
            <TextBlock Text="Thumbprint da Session (na ficha da máquina, na pasta maquinas do pacote de instalação, ou no agent.log da máquina):" Margin="0,0,0,4" TextWrapping="Wrap" />
            <TextBox x:Name="ThumbprintTextBox" Margin="0,0,0,8" TextChanged="OnRosterFieldChanged" />
            <TextBlock Text="Thumbprint do Agent (na mesma ficha; sem ele não dá para bloquear sites e programas, desligar nem atualizar a máquina):" Margin="0,0,0,4" TextWrapping="Wrap" />
            <TextBox x:Name="AgentThumbprintTextBox" Margin="0,0,0,8" />
            <Button Content="Testar a conexão (abre a tela, só para ver)" Click="OnConnectClicked" />
            <TextBlock x:Name="ConnectStatusTextBlock" Margin="0,4,0,8" TextWrapping="Wrap" />
            <Button x:Name="SaveButton" Content="Salvar na lista da sala" Click="OnSaveClicked" IsEnabled="False" />
            <TextBlock x:Name="SaveStatusTextBlock" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11" Foreground="Gray" />
        </StackPanel>
    </ScrollViewer>
</Window>
