<local:MidviewWindow x:Class="Midview.Master.ScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Midview.Master"
        Title="Agendar ligar e desligar" Height="700" Width="600"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="TimelineMark" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="FontSize" Value="10.5" />
        </Style>
        <!-- "Ligar às" / "Desligar às": clicking it flips its switch (Tag), as a check box label does. -->
        <Style x:Key="OnOffTitle" TargetType="TextBlock" BasedOn="{StaticResource CardTitle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <EventSetter Event="MouseLeftButtonUp" Handler="OnSwitchTitleClicked" />
        </Style>
    </Window.Resources>
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <local:DialogHeader Icon="&#xE787;" Heading="Agendar ligar e desligar" Accent="{StaticResource EnergiaBrush}">
            <TextBlock x:Name="TargetsTextBlock" Style="{StaticResource Hint}" />
        </local:DialogHeader>

        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <!-- Only for a room with phones or tablets (ScheduleText.AndroidHint). -->
            <TextBlock x:Name="AndroidHintTextBlock" Style="{StaticResource Hint}" TextWrapping="Wrap"
                       Visibility="Collapsed" Margin="0,0,0,12" />
            <TextBlock Text="Nos dias" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
            <WrapPanel x:Name="DaysPanel">
                <CheckBox x:Name="MondayCheckBox" Content="Seg" Style="{StaticResource DayPillCheckBox}" Margin="0,0,6,0" />
                <CheckBox x:Name="TuesdayCheckBox" Content="Ter" Style="{StaticResource DayPillCheckBox}" Margin="0,0,6,0" />
                <CheckBox x:Name="WednesdayCheckBox" Content="Qua" Style="{StaticResource DayPillCheckBox}" Margin="0,0,6,0" />
                <CheckBox x:Name="ThursdayCheckBox" Content="Qui" Style="{StaticResource DayPillCheckBox}" Margin="0,0,6,0" />
                <CheckBox x:Name="FridayCheckBox" Content="Sex" Style="{StaticResource DayPillCheckBox}" Margin="0,0,6,0" />
                <CheckBox x:Name="SaturdayCheckBox" Content="Sáb" Style="{StaticResource DayPillCheckBox}" Margin="0,0,6,0" />
                <CheckBox x:Name="SundayCheckBox" Content="Dom" Style="{StaticResource DayPillCheckBox}" />
            </WrapPanel>
        </StackPanel>

        <!-- Turning on and turning off, side by side. -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                   Foreground="{StaticResource EnergiaBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" Text="Ligar às" Style="{StaticResource OnOffTitle}" Tag="{Binding ElementName=WakeCheckBox}" />
                        <CheckBox Grid.Column="2" x:Name="WakeCheckBox" Style="{StaticResource SwitchCheckBox}" VerticalAlignment="Center"
                                  AutomationProperties.Name="Ligar às" />
                    </Grid>
                    <TextBox x:Name="WakeTimeTextBox" Style="{StaticResource TimeBox}" Text="07:00" Margin="0,12,0,0" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                               Text="Este computador manda o pedido para ligar (Wake-on-LAN) no horário: ele precisa estar ligado ou em suspensão, com você conectado no Windows. As máquinas precisam do Wake-on-LAN ativado na BIOS (veja o LEIA-ME do pacote de instalação)." />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                   Foreground="{StaticResource EnergiaBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" Text="Desligar às" Style="{StaticResource OnOffTitle}" Tag="{Binding ElementName=ShutdownCheckBox}" />
                        <CheckBox Grid.Column="2" x:Name="ShutdownCheckBox" Style="{StaticResource SwitchCheckBox}" VerticalAlignment="Center"
                                  AutomationProperties.Name="Desligar às" />
                    </Grid>
                    <TextBox x:Name="ShutdownTimeTextBox" Style="{StaticResource TimeBox}" Text="18:00" Margin="0,12,0,0" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                               Text="Cada máquina desliga sozinha, mesmo com este computador desligado. O aluno é avisado 5 minutos antes, e o que não estiver salvo é perdido. Durante o aviso, &quot;Desligar a turma...&quot; &gt; &quot;Cancelar desligamento&quot; cancela." />
                </StackPanel>
            </Border>
        </Grid>

        <!-- The day ruler: the stretches the lab is on, placed by UpdateTimeline. -->
        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <Grid x:Name="TimelineTrack" Height="30" Background="{StaticResource CardBrush}" SizeChanged="OnTimelineSizeChanged">
                <Grid.Clip>
                    <RectangleGeometry x:Name="TimelineClip" RadiusX="8" RadiusY="8" />
                </Grid.Clip>
                <Border x:Name="TimelineFirstSegment" HorizontalAlignment="Left" Margin="0,3" CornerRadius="6" Visibility="Collapsed"
                        Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" />
                <Border x:Name="TimelineSecondSegment" HorizontalAlignment="Left" Margin="0,3" CornerRadius="6" Visibility="Collapsed"
                        Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" />
                <TextBlock x:Name="TimelineTextBlock" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource AccentTextBrush}" />
            </Grid>
            <Grid Margin="2,4,2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="0h" Style="{StaticResource TimelineMark}" />
                <TextBlock Grid.Column="2" Text="6h" Style="{StaticResource TimelineMark}" />
                <TextBlock Grid.Column="4" Text="12h" Style="{StaticResource TimelineMark}" />
                <TextBlock Grid.Column="6" Text="18h" Style="{StaticResource TimelineMark}" />
                <TextBlock Grid.Column="8" Text="24h" Style="{StaticResource TimelineMark}" />
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,12,0,0" Orientation="Horizontal">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=LastRunTextBlock}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="14"
                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock x:Name="LastRunTextBlock" Style="{StaticResource Hint}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Progress and per-machine results; the card shows only when there is text, and
             fills the rest of the window so a whole class's results scroll inside it. -->
        <Border Grid.Row="5" Margin="0,12,0,0">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource ResultCard}">
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Text, ElementName=ProgressTextBlock}" Value="" />
                                <Condition Binding="{Binding Text, ElementName=ResultTextBlock}" Value="" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <TextBlock x:Name="ProgressTextBlock" DockPanel.Dock="Top" TextWrapping="Wrap" FontWeight="SemiBold" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ResultTextBlock" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Button Grid.Row="6" x:Name="SaveButton" Content="Salvar agendamento" Click="OnSaveClicked"
                Style="{StaticResource PrimaryButton}" Padding="16,7" HorizontalAlignment="Right" Margin="0,16,0,0" />
    </Grid>
</local:MidviewWindow>
