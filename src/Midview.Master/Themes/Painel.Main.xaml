<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Midview.Master">
    <!-- The classroom window (MainWindow): its own title bar, the toolbar's
         groups and the students' screens. -->
    <SolidColorBrush x:Key="ToolbarHoverBrush" Color="#1F2C45" />
    <SolidColorBrush x:Key="ToolbarPressedBrush" Color="#22314D" />
    <SolidColorBrush x:Key="TileSelectedBrush" Color="#132A33" />
    <SolidColorBrush x:Key="CloseHoverBrush" Color="#C42B1C" />

    <!-- Minimize, maximize and close, drawn by the window itself (WindowChrome):
         icon glyphs, never taking the keyboard, like Windows' own. The hover
         color is a style trigger on Background, so the maximize button, whose
         mouse Windows sends as non-client messages (MainWindow.TitleBar.cs),
         can be lit from code instead. -->
    <Style x:Key="TitleBarButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ToolbarHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource ToolbarPressedBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="TitleBarCloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource CloseHoverBrush}" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource CloseHoverBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Opacity" Value="0.8" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A pill on the title bar ("Aula: 7º A", "16 de 18 ligadas"). -->
    <Style x:Key="TitleChip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10,2" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextElement.FontSize" Value="11.5" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <!-- One group of the toolbar: a rounded panel with its buttons, then its
         name. Its color (ToolbarButton.IconBrush, set on the panel) reaches
         the buttons' icons and the dot by the name. -->
    <Style x:Key="ToolbarGroupPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="2,2,2,0" />
        <!-- 4 between groups, across and, when they wrap, down. -->
        <Setter Property="Margin" Value="2" />
    </Style>
    <Style x:Key="ToolbarGroupCaption" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center"
                                 Fill="{Binding (local:ToolbarButton.IconBrush), RelativeSource={RelativeSource Self}}" />
                        <local:SpacedCapsText Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                              FontFamily="{StaticResource UiFont}" FontSize="9.5" Spacing="0.13"
                                              Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:ToolbarButton">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <!-- The group panel's own color, so the badge's disc (which takes it)
             hides what of the icon is under the badge. -->
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <!-- At 11 the widest words ("Desinstalar" 56.5, "laboratório" 54.5,
             "programas" 54, "Mensagem" 53.4) don't fit the 52 inside the border
             and padding, so the label takes the whole 58 (below) and none is
             broken mid-word. Narrow enough for the toolbar to keep one row in a
             1340px window (a 1366px screen). -->
        <Setter Property="Width" Value="58" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ToolbarButton">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="8" Padding="2,6,2,2">
                        <StackPanel>
                            <Grid Width="26" Height="22" HorizontalAlignment="Center">
                                <TextBlock x:Name="IconText" Text="{TemplateBinding Icon}" FontFamily="{StaticResource IconFont}"
                                           Foreground="{Binding IconBrush, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue={StaticResource TextBrush}}"
                                           FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <!-- The badge sits on a disc of the button's own color, so it reads over the icon. -->
                                <Border x:Name="BadgeDisc" Width="14" Height="14" CornerRadius="7" Margin="0,0,-3,-3"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Background="{Binding Background, ElementName=Chrome}">
                                    <TextBlock x:Name="BadgeText" Text="{TemplateBinding Badge}" FontFamily="{StaticResource IconFont}"
                                               FontSize="10" Foreground="{StaticResource TextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <!-- "Opens a window of choices": just right of the icon, outside its box,
                                     so the icon stays centred over the label. -->
                                <TextBlock x:Name="OptionsArrow" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,0,-17,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                            </Grid>
                            <!-- Two lines of label. The caption pill (Caption) takes the second one,
                                 so a captioned button keeps the others' height. The label may use the
                                 button's whole width, past its border and padding, for the widest words. -->
                            <StackPanel Margin="-3,5,-3,0" Height="28">
                                <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontSize="11"
                                           TextWrapping="Wrap" TextAlignment="Center"
                                           LineHeight="14" LineStackingStrategy="BlockLineHeight" />
                                <Border x:Name="CaptionPill" CornerRadius="6" Padding="6,0" Margin="0,1,0,0" HorizontalAlignment="Center"
                                        Background="{StaticResource TurmaBrush}">
                                    <TextBlock Text="{TemplateBinding Caption}" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="#1A1300" TextTrimming="CharacterEllipsis"
                                               LineHeight="12" LineStackingStrategy="BlockLineHeight" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Badge" Value="">
                            <Setter TargetName="BadgeDisc" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Caption" Value="">
                            <Setter TargetName="CaptionPill" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="OpensOptions" Value="True">
                            <Setter TargetName="OptionsArrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ToolbarHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ToolbarPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                            <Setter TargetName="IconText" Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                            <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                            <Setter TargetName="OptionsArrow" Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A student machine in the grid: a card around its screen, with the
         machine's line (state dot, name, short status) and any warnings below. -->
    <Style x:Key="MachineTileButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <!-- With the card's border (1) and padding (4): MainWindow.TileLayout.cs's TileChromeWidth. -->
        <Setter Property="Margin" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Card" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="4">
                            <ContentPresenter />
                        </Border>
                        <!-- Selection is drawn over the card's edge, inside its padding,
                             so the screen never moves. Its glow is two faint rings just
                             outside, in the tile's margin, rather than an effect: the whole
                             room can be selected at once, and 31 live effects would weigh.
                             Their negative margins add nothing to the tile's size
                             (TileChromeWidth). -->
                        <Border x:Name="SelectionGlowFar" Margin="-4" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
                                CornerRadius="16" Opacity="0.10" IsHitTestVisible="False" Visibility="Collapsed" />
                        <Border x:Name="SelectionGlowNear" Margin="-2" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
                                CornerRadius="14" Opacity="0.22" IsHitTestVisible="False" Visibility="Collapsed" />
                        <Border x:Name="SelectionRing" BorderBrush="{StaticResource AccentBrush}" BorderThickness="3"
                                CornerRadius="12" IsHitTestVisible="False" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource LineHoverBrush}" />
                        </Trigger>
                        <!-- Focus is not selection (a tile Ctrl+clicked off keeps focus):
                             the subtler hover line, and before the selected trigger so
                             that one still wins on a tile that is both. -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource LineHoverBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Card" Property="Background" Value="{StaticResource TileSelectedBrush}" />
                            <Setter TargetName="SelectionRing" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SelectionGlowNear" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SelectionGlowFar" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
