<Window x:Class="Midview.Master.WakeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ligar máquinas" Height="460" Width="520"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="TargetsTextBlock" TextWrapping="Wrap" FontWeight="Bold" Margin="0,0,0,8" />
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="O Midview manda pela rede um pedido para a placa de rede ligar a máquina (Wake-on-LAN). Ela aparece na grade quando o Windows terminar de iniciar, em 1 ou 2 minutos." />
            <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,8"
                       Text="Se alguma não ligar: ela precisa estar na tomada e no cabo de rede (Wi-Fi não serve), na mesma rede deste computador, e com o Wake-on-LAN ativado na BIOS (veja o LEIA-ME do pacote de instalação)." />
            <Button x:Name="WakeButton" Content="Ligar" Click="OnWakeClicked" Padding="10,4" HorizontalAlignment="Left" />
            <TextBlock x:Name="ProgressTextBlock" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
            <TextBlock x:Name="ResultTextBlock" TextWrapping="Wrap" />
        </ScrollViewer>
    </DockPanel>
</Window>
