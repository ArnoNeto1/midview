<local:MidviewWindow x:Class="Midview.Master.OpenWebsiteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Midview.Master"
        Title="Abrir site" Height="580" Width="520" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=AddressTextBox}">
    <DockPanel Margin="24,22,24,20">
        <StackPanel DockPanel.Dock="Top">
            <local:DialogHeader Icon="&#xE774;" Heading="Abrir site" Accent="{StaticResource ProgramasBrush}">
                <TextBlock x:Name="TargetsTextBlock" Style="{StaticResource Hint}" />
            </local:DialogHeader>
            <Border Style="{StaticResource Card}" Margin="0,16,0,10">
                <StackPanel>
                    <TextBlock x:Name="HintTextBlock" Style="{StaticResource Hint}" Margin="0,0,0,10" TextWrapping="Wrap"
                               Text="Abre o site no navegador do aluno. Um site bloqueado continua bloqueado, e com a tela bloqueada ele abre por baixo do cadeado." />
                    <!-- With phones among PCs: how a phone opens it. -->
                    <TextBlock x:Name="PhoneNoteTextBlock" Style="{StaticResource Hint}" Margin="0,-4,0,10" TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock Text="Endereço do site:" Margin="0,0,0,4" />
                    <TextBox x:Name="AddressTextBox" Padding="4,3" MaxLength="20000" TextChanged="OnAddressChanged" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Para abrir mais de um site, separe com vírgula: www.google.com, www.youtube.com" />
                    <TextBlock x:Name="ProblemTextBlock" Style="{StaticResource ErrorText}" Margin="0,4,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <CheckBox x:Name="SaveCheckBox" Content="Salvar no menu"
                              Checked="OnSaveChanged" Unchecked="OnSaveChanged"
                              ToolTip="Fica no menu do botão &quot;Abrir site&quot;, para abrir com um clique da próxima vez." />
                    <StackPanel x:Name="NamePanel" Orientation="Horizontal" Margin="24,8,0,0" IsEnabled="False">
                        <TextBlock Text="Nome no menu:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="NameTextBox" Width="220" Padding="4,3" MaxLength="60"
                                 ToolTip="Em branco, o menu usa o nome do site (por exemplo, youtube.com)." />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Button x:Name="OpenButton" Content="Abrir nas máquinas" Click="OnOpenClicked" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" Padding="14,6" Margin="0,0,0,10" HorizontalAlignment="Left" />
        </StackPanel>
        <Border Style="{StaticResource ResultCard}">
            <DockPanel>
                <TextBlock x:Name="ProgressTextBlock" DockPanel.Dock="Top" TextWrapping="Wrap" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ResultTextBlock" TextWrapping="Wrap" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</local:MidviewWindow>
