<local:MidviewWindow x:Class="Midview.Master.PreparePhonesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Midview.Master"
        Title="Preparar celulares" Height="860" Width="560" MinHeight="400" MinWidth="480"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="24,18,24,18">
        <local:DialogHeader DockPanel.Dock="Top" Icon="&#xE8EA;" Heading="Preparar celulares" Accent="{StaticResource ConfigurarBrush}" />

        <!-- Where the teacher is, and the Wi-Fi the QR carries ("trocar" goes back to it). -->
        <DockPanel DockPanel.Dock="Top" Margin="0,10,0,0">
            <TextBlock x:Name="WifiLine" DockPanel.Dock="Right" Style="{StaticResource Hint}" TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" MaxWidth="240" Margin="12,0,0,0">
                <Run Text="Wi-Fi:" /> <Run x:Name="WifiNameRun" /> ·
                <Hyperlink Click="OnChangeWifiClicked">trocar</Hyperlink>
            </TextBlock>
            <TextBlock x:Name="CaptionText" Style="{StaticResource Hint}" FontWeight="SemiBold" />
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0" LastChildFill="False">
            <Button x:Name="BackButton" DockPanel.Dock="Left" Content="Voltar" Click="OnBackClicked" Padding="16,6" MinWidth="80" />
            <Button x:Name="NextButton" DockPanel.Dock="Right" Click="OnNextClicked" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" Padding="16,6" Margin="8,0,0,0" />
            <Button x:Name="OtherButton" DockPanel.Dock="Right" Click="OnOtherClicked" Padding="16,6" MinWidth="80" />
        </DockPanel>

        <ScrollViewer x:Name="PageScroll" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <StackPanel x:Name="PageContent">
            <Grid>
                <!-- Wi-Fi do laboratório (only the first time, or "trocar") -->
                <StackPanel x:Name="WifiPage">
                    <TextBlock Text="Wi-Fi do laboratório" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,6,0,14"
                               Text="O celular usa esta rede para entrar na internet e baixar o Midview. Use a mesma rede deste computador. Ela fica guardada só neste computador, protegida pelo Windows." />
                    <TextBlock Style="{StaticResource Hint}" Text="Nome da rede" />
                    <TextBox x:Name="SsidInput" Margin="0,3,0,10" Padding="6,4" />
                    <TextBlock Style="{StaticResource Hint}" Text="Senha" />
                    <TextBox x:Name="PasswordInput" Margin="0,3,0,10" Padding="6,4" />
                    <TextBlock x:Name="WifiErrorText" Style="{StaticResource ErrorText}" />
                </StackPanel>

                <!-- One step of PhoneSetupGuide -->
                <StackPanel x:Name="StepPage">
                    <!-- "Apagar e preparar de novo": the number is a phone of the class, online. -->
                    <Border x:Name="WipeCard" Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock x:Name="WipeText" TextWrapping="Wrap" />
                            <Button x:Name="WipeButton" Content="Apagar e preparar de novo" Click="OnWipeClicked"
                                    Style="{StaticResource DangerButton}" Padding="16,6" Margin="0,10,0,0" HorizontalAlignment="Left" />
                            <TextBlock x:Name="WipeStatusText" Style="{StaticResource Hint}" FontSize="13" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- The phone's screen, the spot to touch outlined in red over it. -->
                        <Border x:Name="PhoneFrame" BorderBrush="#05070C" BorderThickness="5" CornerRadius="20" Background="#05070C"
                                Margin="0,0,18,0" VerticalAlignment="Top" HorizontalAlignment="Left">
                            <Grid x:Name="PhoneScreen">
                                <Image x:Name="StepImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                                <Canvas>
                                    <Border x:Name="TargetGlow" BorderBrush="#40E5383B" BorderThickness="4" CornerRadius="11">
                                        <Border BorderBrush="#E5383B" BorderThickness="3" CornerRadius="8" />
                                    </Border>
                                </Canvas>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="StepTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <StackPanel x:Name="TapsPanel" Margin="0,12,0,0" />
                            <TextBlock x:Name="TimingText" Style="{StaticResource Hint}" FontSize="13" Margin="0,4,0,0" />

                            <!-- numero: the phone's number, and once the school's total -->
                            <StackPanel x:Name="NumberInputs">
                                <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,0,0,10"
                                           Text="O número vira o nome do celular no Midview: o 7 aparece como &quot;Celular 07&quot;." />
                                <TextBlock Style="{StaticResource Hint}" Text="Número do celular" />
                                <TextBox x:Name="NumberInput" Width="110" HorizontalAlignment="Left" FontSize="22" Padding="8,4"
                                         MaxLength="3" Margin="0,3,0,8" />
                                <TextBlock x:Name="NumberErrorText" Style="{StaticResource ErrorText}" Margin="0,0,0,8" />
                                <StackPanel x:Name="TotalInputs" Margin="0,6,0,0">
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Quantos celulares a escola tem para preparar? (Pode deixar em branco. Só é perguntado agora.)" />
                                    <TextBox x:Name="TotalInput" Width="110" HorizontalAlignment="Left" Padding="6,4" MaxLength="3" Margin="0,3,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- seis-toques: the QR with this phone's number and a one-use proof -->
                    <Border x:Name="QrCard" Style="{StaticResource Card}" Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Light on purpose: a QR code needs a light margin around it to be read. -->
                            <Border Background="#FFFFFF" CornerRadius="8" Padding="12" VerticalAlignment="Top">
                                <Image x:Name="QrImage" Width="320" Height="320" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="QrText" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,8,0,0"
                                           Text="Segure o celular a um braço de distância do monitor." />
                                <TextBlock x:Name="QrWarningText" Style="{StaticResource WarningText}" FontSize="12" Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Já existe um Celular 07 -->
                <StackPanel x:Name="ConfirmRedoPage">
                    <TextBlock x:Name="ConfirmRedoTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="ConfirmRedoHint" Style="{StaticResource Hint}" FontSize="13" Margin="0,8,0,0" />
                </StackPanel>

                <!-- Esperando o Celular 07 -->
                <StackPanel x:Name="WaitingPage">
                    <TextBlock Text="&#xE823;" FontFamily="{StaticResource IconFont}" FontSize="36" Foreground="{StaticResource AccentBrush}"
                               Margin="0,4,0,12" HorizontalAlignment="Left" />
                    <TextBlock x:Name="WaitingTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,8,0,0"
                               Text="O celular está entrando no Wi-Fi e baixando o Midview; isso leva alguns minutos." />
                    <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,8,0,0"
                               Text="Se o celular mostrar telas pedindo para aceitar, toque em &quot;Aceitar&quot; ou &quot;Continuar&quot; até aparecer a tela do Midview." />
                    <TextBlock x:Name="WaitingJoinText" Style="{StaticResource Hint}" FontSize="13" Margin="0,8,0,0" />
                </StackPanel>

                <!-- O Celular 07 ainda não apareceu -->
                <StackPanel x:Name="NotAppearedPage">
                    <TextBlock x:Name="NotAppearedTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,6,0,12" Text="Confira, nesta ordem:" />
                    <StackPanel x:Name="NotAppearedList" />
                    <Border Style="{StaticResource Card}" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Se o celular terminar depois de 1 hora" />
                            <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,4,0,0"
                                       Text="O código vale por 1 hora. Se o celular terminar depois disso, ele não entra sozinho na turma: abra &quot;Máquinas da sala&quot;, use &quot;Procurar e parear&quot;, escolha o celular e confira o código de 6 dígitos que aparece nele." />
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,12,0,0"
                               Text="O Midview continua esperando: se o celular aparecer, esta tela muda sozinha." />
                </StackPanel>

                <!-- Celular 07 pronto -->
                <StackPanel x:Name="ReadyPage">
                    <TextBlock Text="&#xE930;" FontFamily="{StaticResource IconFont}" FontSize="40" Foreground="{StaticResource OnlineBrush}"
                               Margin="0,4,0,12" HorizontalAlignment="Left" />
                    <TextBlock x:Name="ReadyTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="ReadyHint" Style="{StaticResource Hint}" FontSize="13" Margin="0,8,0,0" />
                </StackPanel>

            </Grid>

            <!-- "Deu errado?" under every page that has helps: a link that opens them. -->
            <StackPanel x:Name="HelpArea" Margin="0,16,0,0">
                <TextBlock FontSize="13">
                    <Hyperlink Click="OnHelpClicked"><Run x:Name="HelpLinkRun" Text="Deu errado?" /></Hyperlink>
                </TextBlock>
                <StackPanel x:Name="HelpList" Margin="0,10,0,0" />
            </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</local:MidviewWindow>
