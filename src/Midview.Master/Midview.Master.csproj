<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The Midview logo; made by assets\gerar-icone.py. -->
    <ApplicationIcon>..\..\assets\midview.ico</ApplicationIcon>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <!-- The logo's pieces for the opening (SplashWindow); made by assets\gerar-animacao.py. -->
    <Resource Include="..\..\assets\animacao\*.png" Link="Animacao\%(Filename)%(Extension)" />
    <!-- The same logo for the classroom window's own title bar (MainWindow.TitleBar.cs). -->
    <Resource Include="..\..\assets\midview.ico" Link="midview.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Midview.Protocol\Midview.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- DPAPI, for the stored lab admin password (AdminPasswordStore). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- The QR code of "Preparar celular" (PreparePhoneWindow). MIT. -->
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Midview.Master.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
