<local:MidviewWindow x:Class="Midview.Master.QuestionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Midview.Master"
        SizeToContent="Height" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=YesButton}">
    <StackPanel Margin="20">
        <TextBlock x:Name="QuestionTextBlock" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="YesButton" Click="OnYesClicked" IsDefault="True" Padding="16,4" />
            <Button x:Name="NoButton" IsCancel="True" Margin="8,0,0,0" Padding="16,4" />
        </StackPanel>
    </StackPanel>
</local:MidviewWindow>
