<local:MidviewWindow x:Class="Midview.Master.PhoneAccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Midview.Master"
        Title="Contas dos celulares e tablets" Height="620" Width="660" MinHeight="440" MinWidth="540"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterOwner">
    <!-- "Contas do aparelho" (minutes, Liberar, Travar agora) or "Sair das contas do Chrome" (one button, confirmed): the mode given. -->
    <DockPanel Margin="24,22,24,20">
        <StackPanel DockPanel.Dock="Top">
            <local:DialogHeader x:Name="DialogHeading" Icon="&#xE77B;" Heading="Contas dos celulares e tablets" Accent="{StaticResource CelularesBrush}">
                <TextBlock x:Name="TargetsTextBlock" Style="{StaticResource Hint}" />
            </local:DialogHeader>
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock x:Name="ExplanationTextBlock" Style="{StaticResource Hint}" TextWrapping="Wrap" />
                    <StackPanel x:Name="MinutesPanel" Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="Liberar por" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0" />
                        <RadioButton x:Name="TenMinutesRadioButton" GroupName="Minutes" Content="10 minutos" IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <RadioButton x:Name="ThirtyMinutesRadioButton" GroupName="Minutes" Content="30 minutos" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <RadioButton x:Name="SixtyMinutesRadioButton" GroupName="Minutes" Content="60 minutos" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel x:Name="AccountsButtons" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="FreeButton" Content="Liberar" Click="OnFreeClicked"
                                Style="{StaticResource PrimaryButton}" Padding="14,6" Margin="0,0,8,0" IsDefault="True" />
                        <Button x:Name="LockButton" Content="Travar agora" Click="OnLockClicked" Padding="14,6" />
                    </StackPanel>
                    <Button x:Name="ClearChromeButton" Content="Sair das contas do Chrome" Click="OnClearChromeClicked"
                            Style="{StaticResource DangerButton}" HorizontalAlignment="Left" Padding="14,6" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="ProgressTextBlock" Margin="0,14,0,10" TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="PhonesList" ItemTemplate="{StaticResource PhoneRowTemplate}" />
        </ScrollViewer>
    </DockPanel>
</local:MidviewWindow>
