<local:MidviewWindow x:Class="Midview.Master.AppBlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Midview.Master"
        Title="Bloquear programas" Height="700" Width="760" MinHeight="600"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="24,22,24,20">
        <StackPanel DockPanel.Dock="Top">
            <local:DialogHeader Icon="&#xECAA;" Heading="Bloquear programas" Accent="{StaticResource ProgramasBrush}">
                <TextBlock x:Name="TargetsTextBlock" Style="{StaticResource Hint}" />
            </local:DialogHeader>
            <TextBlock x:Name="StateTextBlock" Style="{StaticResource Hint}" Margin="0,10,0,10" Text="Lendo o estado atual..." />

            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="12,10">
                <RadioButton x:Name="BlockListRadioButton" GroupName="Mode" IsChecked="True">
                    <TextBlock TextWrapping="Wrap" Text="Bloquear só os programas escolhidos — o resto continua funcionando." />
                </RadioButton>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="12,10">
                <RadioButton x:Name="AllowOnlyRadioButton" GroupName="Mode">
                    <TextBlock TextWrapping="Wrap" Text="Permitir só os programas escolhidos — todo o resto é fechado ao abrir (o Windows e o Midview continuam funcionando)." />
                </RadioButton>
            </Border>
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                       Text="O Prompt de Comando e o PowerShell também são fechados, a menos que estejam na lista. Alguns programas usam auxiliares sem janela (o Terminal do Windows usa o OpenConsole.exe): se algo fechar sozinho, adicione também o auxiliar. Os aplicativos da Microsoft Store (Calculadora, Fotos) não aparecem na lista. Teste antes em uma máquina." />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <DockPanel Margin="0,0,0,4">
                <Button x:Name="AddButton" DockPanel.Dock="Right" Content="Adicionar" Click="OnAddClicked" Padding="12,5" Margin="8,0,0,0" />
                <TextBox x:Name="AddTextBox" VerticalContentAlignment="Center" KeyDown="OnAddKeyDown" />
            </DockPanel>
            <TextBlock x:Name="AddHintTextBlock" Style="{StaticResource Hint}"
                       Text="Adicionar pelo nome (por exemplo chrome.exe)." Margin="0,0,0,10" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button x:Name="ApplyButton" Content="Aplicar bloqueio" Click="OnApplyClicked"
                        Style="{StaticResource PrimaryButton}" Padding="14,6" Margin="0,0,8,0" />
                <Button x:Name="LiftButton" Content="Liberar tudo" Click="OnLiftClicked" Padding="14,6" />
            </StackPanel>
            <Border Style="{StaticResource ResultCard}">
                <DockPanel>
                    <TextBlock x:Name="ProgressTextBlock" DockPanel.Dock="Top" TextWrapping="Wrap" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="90">
                        <TextBlock x:Name="ResultTextBlock" TextWrapping="Wrap" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </StackPanel>

        <Border Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Atualizar lista" Click="OnRefreshClicked" Padding="10,4" Margin="8,0,0,0" />
                    <TextBlock Text="Programas abertos" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ProgramsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Checked, Mode=TwoWay}" Margin="0,3">
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="Bold" />
                                        <Run Text="{Binding Detail, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" />
                                    </TextBlock>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</local:MidviewWindow>
