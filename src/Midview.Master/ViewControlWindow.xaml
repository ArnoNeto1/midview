<local:MidviewWindow x:Class="Midview.Master.ViewControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Midview.Master"
        Title="Midview" Height="700" Width="1280" WindowStartupLocation="CenterScreen"
        Closed="OnWindowClosed" Loaded="OnWindowLoaded">
    <Window.Resources>
        <!-- The StatusChip look, with a gentler corner: the mode sentence is long, and a full pill would turn it into a lens. -->
        <Style x:Key="ModeChip" TargetType="Label" BasedOn="{StaticResource StatusChip}">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Label">
                        <Border CornerRadius="8" BorderThickness="1" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!-- The picture takes the whole window; the toolbar floats over its top and
         slides away (ViewControlWindow.Layout.cs). -->
    <Grid x:Name="ViewRoot" Background="Black" ClipToBounds="True"
          PreviewMouseMove="OnViewMouseMove" MouseLeave="OnViewMouseLeave">
        <Image x:Name="ScreenImage" Stretch="Uniform"
               MouseMove="OnMouseMove" MouseLeftButtonDown="OnMouseLeftDown" MouseLeftButtonUp="OnMouseLeftUp"
               MouseRightButtonDown="OnMouseRightDown" MouseRightButtonUp="OnMouseRightUp"
               KeyDown="OnKeyDown" KeyUp="OnKeyUp" TextInput="OnTextInput" MouseWheel="OnMouseWheel" Focusable="True" />
        <Border x:Name="Toolbar" VerticalAlignment="Top" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToolbarSlide" />
            </Border.RenderTransform>
            <StackPanel>
                <!-- Wraps in a narrow window (a phone's, in its own shape) instead of cutting the buttons off. -->
                <WrapPanel Orientation="Horizontal">
                    <Button x:Name="ControlButton" Click="OnControlClicked" Padding="10,4" Margin="8,6,4,6" />
                    <Button x:Name="FullscreenButton" Content="Tela Cheia" Click="OnFullscreenClicked" Padding="10,4" Margin="4,6" />
                    <Button Content="Desconectar" Click="OnDisconnectClicked" Padding="10,4" Margin="4,6" />
                    <!-- A phone's only (ShowMode): Android's three buttons, while controlling. -->
                    <StackPanel x:Name="PhoneButtons" Orientation="Horizontal" Visibility="Collapsed">
                        <Button Content="Voltar" Click="OnPhoneBackClicked" Padding="10,4" Margin="4,6"
                                ToolTip="O botão Voltar do celular (no teclado: Esc)." />
                        <Button Content="Início" Click="OnPhoneHomeClicked" Padding="10,4" Margin="4,6"
                                ToolTip="Vai para a tela inicial do celular (no teclado: tecla Windows)." />
                        <Button Content="Recentes" Click="OnPhoneRecentsClicked" Padding="10,4" Margin="4,6"
                                ToolTip="Mostra os apps abertos no celular." />
                    </StackPanel>
                    <!-- A phone's only (ShowMode): sent with StartControl and whenever it changes. -->
                    <CheckBox x:Name="LockTouchCheckBox" IsChecked="True" VerticalAlignment="Center" Margin="8,6,4,6"
                              Visibility="Collapsed" Checked="OnLockTouchChanged" Unchecked="OnLockTouchChanged" />
                    <!-- Only on the helper connection (ShowMode): the password never goes over the Session. -->
                    <Button x:Name="FillPasswordButton" Content="Preencher a senha de administrador" Click="OnFillPasswordClicked"
                            Padding="10,4" Margin="4,6" Visibility="Collapsed" />
                    <Button x:Name="ChangePasswordButton" Content="Trocar senha de administrador..." Click="OnChangePasswordClicked"
                            Padding="10,4" Margin="4,6" Visibility="Collapsed" />
                    <!-- ShowMode sets the colors: accent while controlling, muted while only viewing. -->
                    <Label x:Name="ModeTextBlock" Style="{StaticResource ModeChip}" VerticalAlignment="Center" Margin="12,4,8,4" />
                </WrapPanel>
                <Border x:Name="CompatibilityNote" Visibility="Collapsed">
                    <Border.Background>
                        <SolidColorBrush Color="#FFC53D" Opacity="0.16" />
                    </Border.Background>
                    <TextBlock Foreground="{StaticResource WarningBrush}" Margin="12,5"
                               Text="Controle em modo compatível: não responde à tela do UAC." />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</local:MidviewWindow>
