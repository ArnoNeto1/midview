<Window x:Class="Midview.Master.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Midview" Width="560" Height="400"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" Topmost="True" Background="Black" Cursor="Hand"
        MouseDown="OnMouseDown">
    <!-- The logo's pieces (assets\animacao), all the same size and position:
         stacked, they are the logo. Each starts as the animation begins. -->
    <Grid Width="524" Height="375" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Image Source="/Animacao/rede.png" Stretch="None">
            <Image.OpacityMask>
                <!-- Grows from the eye, so the network spreads out from it. -->
                <RadialGradientBrush x:Name="NetworkReveal" MappingMode="Absolute"
                                     Center="262,128" GradientOrigin="262,128" RadiusX="0" RadiusY="0">
                    <GradientStop Color="Black" Offset="0" />
                    <GradientStop Color="Black" Offset="0.88" />
                    <GradientStop Color="Transparent" Offset="1" />
                </RadialGradientBrush>
            </Image.OpacityMask>
        </Image>
        <Image x:Name="Monitor" Source="/Animacao/monitor.png" Stretch="None" Opacity="0" RenderTransformOrigin="0.5,0.341">
            <Image.RenderTransform>
                <ScaleTransform x:Name="MonitorScale" ScaleX="0.6" ScaleY="0.6" />
            </Image.RenderTransform>
        </Image>
        <Image x:Name="Eye" Source="/Animacao/olho.png" Stretch="None" Opacity="0" RenderTransformOrigin="0.5,0.341">
            <Image.RenderTransform>
                <ScaleTransform x:Name="EyeScale" ScaleX="0.3" ScaleY="0.3" />
            </Image.RenderTransform>
        </Image>
        <Image x:Name="InnerWaves" Source="/Animacao/ondas-dentro.png" Stretch="None" Opacity="0" />
        <Image x:Name="OuterWaves" Source="/Animacao/ondas-fora.png" Stretch="None" Opacity="0" />
        <Image x:Name="Word" Source="/Animacao/palavra.png" Stretch="None" Opacity="0">
            <Image.RenderTransform>
                <TranslateTransform x:Name="WordShift" Y="18" />
            </Image.RenderTransform>
        </Image>
    </Grid>
</Window>
