<local:MidviewWindow x:Class="Midview.Master.CloseAppsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Midview.Master"
        Title="Fechar programas" Height="680" Width="540" MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="24,22,24,20">
        <StackPanel DockPanel.Dock="Top">
            <local:DialogHeader Icon="&#xE711;" Heading="Fechar programas" Accent="{StaticResource ProgramasBrush}">
                <TextBlock x:Name="TargetsTextBlock" Style="{StaticResource Hint}" />
            </local:DialogHeader>
            <TextBlock x:Name="HintTextBlock" Style="{StaticResource Hint}" Margin="0,12,0,0" TextWrapping="Wrap" />
            <Border x:Name="ModeCard" Style="{StaticResource Card}" Margin="0,12,0,10">
                <StackPanel>
                    <RadioButton x:Name="AskRadioButton" GroupName="Mode" IsChecked="True" Margin="0,0,0,8">
                        <TextBlock TextWrapping="Wrap"
                                   Text="Pedir para fechar: como clicar no X de cada janela. Programas com trabalho não salvo perguntam ao aluno antes." />
                    </RadioButton>
                    <RadioButton x:Name="ForceRadioButton" GroupName="Mode">
                        <TextBlock Style="{StaticResource WarningText}"
                                   Text="Forçar: encerra os programas sem perguntar. Trabalho não salvo é perdido." />
                    </RadioButton>
                </StackPanel>
            </Border>
            <Border x:Name="DelayCard" Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <RadioButton x:Name="OneMinuteRadioButton" GroupName="Delay" IsChecked="True" Content="Avisar o aluno e esperar 1 minuto" Margin="0,0,0,4" />
                    <RadioButton x:Name="ThirtySecondsRadioButton" GroupName="Delay" Content="Avisar o aluno e esperar 30 segundos" Margin="0,0,0,4" />
                    <RadioButton x:Name="NowRadioButton" GroupName="Delay" Content="Agora, sem esperar (o aluno é avisado na hora)" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="PhoneNoteTextBlock" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed" />
            <Button x:Name="CloseButton" Content="Fechar programas" Click="OnCloseClicked"
                    Style="{StaticResource PrimaryButton}" Padding="14,6" Margin="0,0,0,10" HorizontalAlignment="Left" />
        </StackPanel>
        <Border Style="{StaticResource ResultCard}">
            <DockPanel>
                <TextBlock x:Name="ProgressTextBlock" DockPanel.Dock="Top" TextWrapping="Wrap" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ResultTextBlock" TextWrapping="Wrap" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</local:MidviewWindow>
