<local:MidviewWindow x:Class="Midview.Master.PhoneUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Midview.Master"
        Title="Atualizar os celulares" Height="640" Width="660" MinHeight="440" MinWidth="540"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterOwner" Closing="OnClosing">
    <DockPanel Margin="24,22,24,20">
        <StackPanel DockPanel.Dock="Top">
            <local:DialogHeader x:Name="DialogHeading" Icon="&#xE8EA;" Heading="Atualizar os celulares" Accent="{StaticResource CelularesBrush}">
                <TextBlock x:Name="TargetsTextBlock" Style="{StaticResource Hint}" />
            </local:DialogHeader>
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock x:Name="ApkTextBlock" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock x:Name="IntroTextBlock" Style="{StaticResource Hint}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <DockPanel Margin="0,14,0,10">
                <Button x:Name="UpdateButton" DockPanel.Dock="Left" Content="Atualizar" Click="OnUpdateClicked"
                        Style="{StaticResource PrimaryButton}" Padding="14,6" Margin="0,0,8,0" IsEnabled="False" />
                <Button x:Name="CheckButton" DockPanel.Dock="Left" Content="Verificar versões" Click="OnCheckClicked"
                        Padding="14,6" Margin="0,0,12,0" IsEnabled="False" />
                <TextBlock x:Name="ProgressTextBlock" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="PhonesList" ItemTemplate="{StaticResource PhoneRowTemplate}" />
        </ScrollViewer>
    </DockPanel>
</local:MidviewWindow>
