<local:MidviewWindow x:Class="Midview.Master.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Midview.Master"
        Title="Desinstalar programa" Height="700" Width="640" MinHeight="580"
        WindowStartupLocation="CenterOwner" Loaded="OnWindowLoaded">
    <DockPanel Margin="24,22,24,20">
        <StackPanel DockPanel.Dock="Top">
            <local:DialogHeader Icon="&#xE74D;" Heading="Desinstalar programa" Accent="{StaticResource ProgramasBrush}">
                <TextBlock x:Name="TargetsTextBlock" Style="{StaticResource Hint}" />
            </local:DialogHeader>
            <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,12"
                       Text="A lista é lida de uma máquina. Marque os programas e desinstale nela ou na turma toda; cada máquina acha o programa pelo nome, mesmo numa versão diferente. Só remove programas com desinstalação silenciosa; os que não têm, o resultado avisa. Um programa instalado só para um aluno sai agora da conta aberta na máquina, e das outras contas quando cada aluno entrar (nos próximos 14 dias)." />
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Recarregar" Click="OnReloadClicked" Padding="12,5" Margin="12,0,0,0" />
                <TextBlock DockPanel.Dock="Right" Text="(filtrar pelo nome)" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="10,0,0,0" />
                <TextBox x:Name="FilterTextBox" TextChanged="OnFilterChanged" VerticalContentAlignment="Center" />
            </DockPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <CheckBox x:Name="WholeClassCheckBox" Content="Aplicar na turma toda" Margin="0,0,0,10" />
            <Button x:Name="UninstallButton" Content="Desinstalar os marcados" Click="OnUninstallClicked"
                    Style="{StaticResource DangerButton}" Padding="14,6" HorizontalAlignment="Left" Margin="0,0,0,10" />
            <Border Style="{StaticResource ResultCard}">
                <DockPanel>
                    <TextBlock x:Name="ProgressTextBlock" DockPanel.Dock="Top" TextWrapping="Wrap" />
                    <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="ResultTextBlock" TextWrapping="Wrap" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </StackPanel>

        <Border Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ProgramsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,3" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</local:MidviewWindow>
