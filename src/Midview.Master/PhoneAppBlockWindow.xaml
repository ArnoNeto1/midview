<local:MidviewWindow x:Class="Midview.Master.PhoneAppBlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Midview.Master"
        Title="Bloquear apps nos celulares" Height="820" Width="880" MinHeight="560" MinWidth="700"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterOwner">
    <local:MidviewWindow.Resources>
        <!-- One app of the list: a card with the checkbox, the app's icon and
             name; a ticked app's card is lit in the accent color. -->
        <Style x:Key="AppRowCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Row" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" BorderThickness="1" VerticalAlignment="Center"
                                        Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource TextMutedBrush}">
                                    <Path x:Name="Mark" Data="M4,9 L7.5,12.5 L14,5.5" Stroke="{StaticResource OnAccentBrush}" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Stretch="None" Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource LineHoverBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </local:MidviewWindow.Resources>

    <DockPanel Margin="24,22,24,20">
        <StackPanel DockPanel.Dock="Top">
            <local:DialogHeader x:Name="DialogHeading" Icon="&#xE8EA;" Heading="Bloquear apps nos celulares" Accent="{StaticResource ProgramasBrush}">
                <TextBlock x:Name="TargetsTextBlock" Style="{StaticResource Hint}" />
            </local:DialogHeader>
            <TextBlock x:Name="StateTextBlock" Style="{StaticResource Hint}" Margin="0,10,0,10" Text="Lendo o estado atual..." />

            <TextBlock Text="Modo" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="12,10">
                <RadioButton x:Name="BlockListRadioButton" GroupName="PhoneMode" IsChecked="True">
                    <TextBlock TextWrapping="Wrap" Text="Bloquear só estes — os outros apps continuam abrindo." />
                </RadioButton>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="12,10">
                <RadioButton x:Name="AllowOnlyRadioButton" GroupName="PhoneMode">
                    <TextBlock TextWrapping="Wrap" Text="Liberar só estes — todos os outros apps ficam cinza e não abrem (o Midview, a tela inicial, o telefone e as Configurações continuam funcionando)." />
                </RadioButton>
            </Border>
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                       Text="Em &quot;Liberar só estes&quot;, um app instalado depois também fica bloqueado. Para os sites, use &quot;Bloquear sites&quot;: vale também para os celulares." />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button x:Name="ApplyButton" Content="Aplicar bloqueio" Click="OnApplyClicked"
                        Style="{StaticResource PrimaryButton}" Padding="14,6" Margin="0,0,8,0" />
                <Button x:Name="LiftButton" Content="Liberar tudo" Click="OnLiftClicked" Padding="14,6" />
            </StackPanel>
            <Border Style="{StaticResource ResultCard}">
                <DockPanel>
                    <TextBlock x:Name="ProgressTextBlock" DockPanel.Dock="Top" TextWrapping="Wrap" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="90">
                        <TextBlock x:Name="ResultTextBlock" TextWrapping="Wrap" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </StackPanel>

        <Border Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Atualizar lista" Click="OnRefreshClicked" Padding="10,4" Margin="8,0,0,0" />
                    <TextBlock x:Name="ChosenTextBlock" DockPanel.Dock="Right" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                    <TextBlock x:Name="ListTitleTextBlock" Text="Apps dos celulares" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock x:Name="ListTextBlock" DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8"
                           Text="Pedindo a lista de apps..." />
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="AppsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" VerticalAlignment="Top" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Style="{StaticResource AppRowCheckBox}" IsChecked="{Binding Checked, Mode=TwoWay}"
                                          Margin="0,0,8,8" ToolTip="{Binding Package}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource LineBrush}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Initial}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Image Source="{Binding Icon}" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Detail}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</local:MidviewWindow>
