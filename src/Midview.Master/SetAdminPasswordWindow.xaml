<Window x:Class="Midview.Master.SetAdminPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Senha de administrador" SizeToContent="Height" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource CanvasBrush}" FontFamily="{StaticResource UiFont}"
        FocusManager.FocusedElement="{Binding ElementName=PasswordInput}">
    <StackPanel Margin="20">
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource InkMutedBrush}"
                   Text="Digite a senha de administrador do laboratório. Ela fica guardada só neste computador, protegida pelo Windows, e é usada apenas quando você clica em &quot;Preencher a senha de administrador&quot;." />
        <PasswordBox x:Name="PasswordInput" Margin="0,14,0,0" Padding="6,4" />
        <TextBlock x:Name="ErrorTextBlock" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#FFB3261E" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Salvar" Click="OnSaveClicked" IsDefault="True" Padding="16,4" />
            <Button Content="Cancelar" IsCancel="True" Margin="8,0,0,0" Padding="16,4" />
        </StackPanel>
    </StackPanel>
</Window>
