<local:MidviewWindow x:Class="Midview.Master.SetAdminPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Midview.Master"
        Title="Senha de administrador" SizeToContent="Height" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FocusManager.FocusedElement="{Binding ElementName=PasswordInput}">
    <StackPanel Margin="24,22,24,20">
        <local:DialogHeader Icon="&#xE72E;" Heading="Senha de administrador" Accent="{StaticResource ConfigurarBrush}"
                Content="Digite a senha de administrador do laboratório. Ela fica guardada só neste computador, protegida pelo Windows, e é usada apenas quando você clica em &quot;Preencher a senha de administrador&quot;." />
        <PasswordBox x:Name="PasswordInput" Margin="0,16,0,0" Padding="6,4" />
        <TextBlock x:Name="ErrorTextBlock" Margin="0,8,0,0" Style="{StaticResource ErrorText}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" IsCancel="True" Padding="16,5" MinWidth="80" Margin="0,0,8,0" />
            <Button Content="Salvar" Click="OnSaveClicked" IsDefault="True" Style="{StaticResource PrimaryButton}" Padding="16,5" MinWidth="80" />
        </StackPanel>
    </StackPanel>
</local:MidviewWindow>
