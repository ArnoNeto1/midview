<local:MidviewWindow x:Class="Midview.Master.SendMessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Midview.Master"
        Title="Enviar mensagem" Height="460" Width="520"
        WindowStartupLocation="CenterOwner" Loaded="OnWindowLoaded">
    <DockPanel Margin="24,22,24,20">
        <local:DialogHeader DockPanel.Dock="Top" Icon="&#xE8BD;" Heading="Enviar mensagem" Accent="{StaticResource TurmaBrush}">
            <TextBlock x:Name="TargetsTextBlock" Style="{StaticResource Hint}" />
        </local:DialogHeader>
        <StackPanel DockPanel.Dock="Bottom">
            <Button x:Name="SendButton" Content="Enviar" Click="OnSendClicked" IsEnabled="False"
                    Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="14,6" />
            <Border Style="{StaticResource ResultCard}" Margin="0,10,0,0">
                <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ResultTextBlock" TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>
        </StackPanel>
        <TextBox x:Name="MessageTextBox" AcceptsReturn="True" TextWrapping="Wrap" FontSize="14" Margin="0,16,0,0"
                 VerticalScrollBarVisibility="Auto" TextChanged="OnMessageChanged" />
    </DockPanel>
</local:MidviewWindow>
