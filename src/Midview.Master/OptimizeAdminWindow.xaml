<local:MidviewWindow x:Class="Midview.Master.OptimizeAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Midview.Master"
        Title="Senha de administrador dos celulares e tablets" SizeToContent="Height" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FocusManager.FocusedElement="{Binding ElementName=PasswordBox}">
    <StackPanel Margin="24,22,24,20">
        <local:DialogHeader x:Name="DialogHeading" Icon="&#xE72E;" Heading="Senha de administrador dos celulares e tablets" Accent="{StaticResource CelularesBrush}">
            <TextBlock x:Name="LineTextBlock" Style="{StaticResource Hint}" TextWrapping="Wrap" />
        </local:DialogHeader>
        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Senha" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Grid Grid.Row="0" Grid.Column="1" Width="170">
                        <PasswordBox x:Name="PasswordBox" MaxLength="12" FontSize="16" Padding="8,4"
                                     AutomationProperties.Name="Senha de administrador"
                                     PasswordChanged="OnChanged" PreviewTextInput="OnTyping" PreviewKeyDown="OnKeyDown" />
                        <TextBox x:Name="PasswordText" MaxLength="12" FontSize="16" Padding="8,4" Visibility="Collapsed"
                                 AutomationProperties.Name="Senha de administrador"
                                 TextChanged="OnChanged" PreviewTextInput="OnTyping" PreviewKeyDown="OnKeyDown" />
                    </Grid>
                    <CheckBox x:Name="ShowCheckBox" Grid.Row="0" Grid.Column="2" Content="Mostrar" VerticalAlignment="Center"
                              Margin="12,0,0,0" Click="OnShowClicked" />
                    <TextBlock x:Name="RepeatLabel" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,8,10,0" />
                    <Grid Grid.Row="1" Grid.Column="1" Width="170" Margin="0,8,0,0">
                        <PasswordBox x:Name="RepeatBox" MaxLength="12" FontSize="16" Padding="8,4"
                                     AutomationProperties.Name="Repita a senha de administrador"
                                     PasswordChanged="OnChanged" PreviewTextInput="OnTyping" PreviewKeyDown="OnKeyDown" />
                        <TextBox x:Name="RepeatText" MaxLength="12" FontSize="16" Padding="8,4" Visibility="Collapsed"
                                 AutomationProperties.Name="Repita a senha de administrador"
                                 TextChanged="OnChanged" PreviewTextInput="OnTyping" PreviewKeyDown="OnKeyDown" />
                    </Grid>
                </Grid>
                <TextBlock x:Name="HintTextBlock" Style="{StaticResource Hint}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <TextBlock x:Name="ErrorTextBlock" Style="{StaticResource ErrorText}" TextWrapping="Wrap" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="SkipButton" Click="OnSkipClicked" IsCancel="True" Padding="16,6" Margin="0,0,8,0" />
            <Button x:Name="SaveButton" Click="OnSaveClicked" IsDefault="True" Style="{StaticResource PrimaryButton}" Padding="16,6" />
        </StackPanel>
    </StackPanel>
</local:MidviewWindow>
