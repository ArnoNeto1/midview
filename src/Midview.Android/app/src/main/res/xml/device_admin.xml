<?xml version="1.0" encoding="utf-8"?>
<!-- The Device Owner's locks (user restrictions, blocked uninstall, the
     app's control) need no policies listed here. limit-password is for the
     teacher's lock screen PIN: Android tells the admin when the PIN changes
     (onPasswordChanged) and takes its PIN rule only with it. force-lock is
     for the teacher's "Desligar", which turns the screen off and locks it
     (lockNow). A phone made Device Owner before reads them at its next
     restart. -->
<device-admin>
    <uses-policies>
        <limit-password />
        <force-lock />
    </uses-policies>
</device-admin>
